@model CvManagementSystem.ViewModels.SupportTicketViewModel

@using CvManagementSystem.ViewModels

@{
    ViewData["Title"] = "Help & Support";

    var priorities = new[]
    {
        new { Value = SupportPriority.High, Label = "High", Hint = "Blocking my work" },
        new { Value = SupportPriority.Average, Label = "Average", Hint = "Something isn't right" },
        new { Value = SupportPriority.Low, Label = "Low", Hint = "Question or suggestion" }
    };
}

@section Styles
{
    <style>
        .support-hero {
            border-bottom: 1px solid var(--color-divider);
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
        }

        .support-hero h1 {
            font-size: clamp(1.9rem, 4vw, 2.5rem);
            letter-spacing: -.03em;
            margin: .35rem 0 .5rem;
        }

        .support-priority .btn {
            align-items: flex-start;
            display: flex;
            flex-direction: column;
            gap: .1rem;
            height: 100%;
            padding: .75rem 1rem;
            text-align: left;
        }

        .support-priority .btn small {
            font-family: var(--font-body);
            font-weight: 400;
            letter-spacing: 0;
            opacity: .75;
        }

        .support-priority .btn-check:checked + .btn {
            background: var(--color-accent-100);
            border-color: var(--color-accent);
            color: var(--color-accent-800);
        }

        .support-priority-dot {
            display: inline-block;
            height: .55rem;
            margin-right: .4rem;
            width: .55rem;
        }

        .support-priority-dot.high { background: var(--bs-danger); }
        .support-priority-dot.average { background: var(--bs-warning); }
        .support-priority-dot.low { background: var(--color-accent); }

        .support-steps {
            counter-reset: step;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .support-steps li {
            counter-increment: step;
            display: flex;
            gap: .85rem;
            padding: .6rem 0;
        }

        .support-steps li + li {
            border-top: 1px solid var(--color-divider);
        }

        .support-steps li::before {
            align-items: center;
            border: 1px solid var(--color-accent);
            color: var(--color-accent);
            content: counter(step);
            display: inline-flex;
            flex: 0 0 1.75rem;
            font-family: var(--font-heading);
            font-weight: 700;
            height: 1.75rem;
            justify-content: center;
        }

        .support-tips li {
            margin-bottom: .4rem;
        }

        .support-counter {
            color: var(--bs-secondary-color);
            font-size: .8rem;
        }
    </style>
}

<div class="container py-4">

    <!-- =============================== -->
    <!-- Header -->
    <!-- =============================== -->

    <div class="support-hero">

        <div class="section-kicker">
            Help Center
        </div>

        <h1>
            How can we help?
        </h1>

        <p class="text-muted mb-0">
            Tell us about the problem you are experiencing and our team
            will look into it as soon as possible.
        </p>

    </div>


    @if (TempData["SupportSuccess"] != null)
    {
        <div class="alert alert-success d-flex align-items-start gap-2 mb-4"
             role="status">

            <div>
                <strong>Request received.</strong>
                <div>@TempData["SupportSuccess"]</div>
            </div>

        </div>
    }


    <div class="row g-4">

        <!-- =============================== -->
        <!-- Support form -->
        <!-- =============================== -->

        <div class="col-lg-8">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="card mb-4">

                    <div class="card-header">

                        <h2 class="h5 mb-0">
                            Submit a support request
                        </h2>

                    </div>

                    <div class="card-body p-4">

                        <!-- Summary -->

                        <div class="mb-4">

                            <label asp-for="Summary"
                                   class="form-label fw-semibold">
                                Summary
                            </label>

                            <textarea asp-for="Summary"
                                      class="form-control"
                                      rows="6"
                                      maxlength="500"
                                      placeholder="Describe the problem, what you expected to happen, and what happened instead..."></textarea>

                            <div class="d-flex justify-content-between mt-1">

                                <span asp-validation-for="Summary"
                                      class="text-danger small">
                                </span>

                                <span class="support-counter ms-auto"
                                      id="supportSummaryCounter">
                                    0 / 500
                                </span>

                            </div>

                        </div>


                        <!-- Priority -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold d-block">
                                Priority
                            </label>

                            <div class="row g-2 support-priority"
                                 role="radiogroup"
                                 aria-label="Priority">

                                @foreach (var priority in priorities)
                                {
                                    var id = $"priority-{priority.Value}";

                                    <div class="col-sm-4">

                                        <input type="radio"
                                               class="btn-check"
                                               asp-for="Priority"
                                               value="@priority.Value"
                                               id="@id"
                                               autocomplete="off" />

                                        <label class="btn btn-outline-secondary w-100"
                                               for="@id">

                                            <span>
                                                <span class="support-priority-dot @priority.Label.ToLowerInvariant()"></span>
                                                @priority.Label
                                            </span>

                                            <small>@priority.Hint</small>

                                        </label>

                                    </div>
                                }

                            </div>

                        </div>


                        <!-- Position -->

                        <div>

                            <label asp-for="PositionId"
                                   class="form-label fw-semibold">
                                Related position
                                <span class="text-muted fw-normal">(optional)</span>
                            </label>

                            <select asp-for="PositionId"
                                    asp-items="Model.Positions"
                                    class="form-select">
                                <option value="">Not related to a specific position</option>
                            </select>

                            <div class="form-text">
                                Pick a position if the issue happened while
                                working with it.
                            </div>

                        </div>

                    </div>

                    <div class="card-footer d-flex flex-column flex-sm-row
                                justify-content-between align-items-sm-center gap-2">

                        <span class="text-muted small">
                            Your name, email and the page you came from are
                            attached automatically.
                        </span>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Submit Support Request
                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- =============================== -->
        <!-- Sidebar -->
        <!-- =============================== -->

        <div class="col-lg-4">

            <div class="card mb-4">

                <div class="card-header">

                    <h2 class="h6 mb-0 text-uppercase"
                        style="letter-spacing: .07em;">
                        What happens next
                    </h2>

                </div>

                <div class="card-body">

                    <ol class="support-steps">
                        <li>
                            <span>Your request is logged as a support ticket.</span>
                        </li>
                        <li>
                            <span>Our team reviews it based on its priority.</span>
                        </li>
                        <li>
                            <span>We follow up with you by email.</span>
                        </li>
                    </ol>

                </div>

            </div>


            <div class="card">

                <div class="card-header">

                    <h2 class="h6 mb-0 text-uppercase"
                        style="letter-spacing: .07em;">
                        Tips for a quick resolution
                    </h2>

                </div>

                <div class="card-body">

                    <ul class="support-tips small text-muted ps-3 mb-0">
                        <li>Describe the steps that led to the problem.</li>
                        <li>Mention any error message you saw.</li>
                        <li>Choose <strong>High</strong> only if you are fully blocked.</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const summary = document.getElementById("Summary");
            const counter = document.getElementById("supportSummaryCounter");

            if (!summary || !counter) {
                return;
            }

            const update = () =>
                counter.textContent = summary.value.length + " / 500";

            summary.addEventListener("input", update);
            update();
        })();
    </script>
}
