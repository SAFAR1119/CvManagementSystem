@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">

    <div class="mb-4">
        <span class="badge text-bg-primary">
            Candidate Profile
        </span>

        <h1 class="fw-bold mt-2">
            My Profile
        </h1>

        <p class="text-secondary">
            Manage your personal information, reusable attributes,
            projects and CVs.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5 fw-bold">
                        Me
                    </h2>

                    <p class="text-secondary">
                        Your core profile information such as name,
                        location and photo.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        Edit information
                    </a>

                </div>
            </div>

        </div>

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5 fw-bold">
                        Info
                    </h2>

                    <p class="text-secondary">
                        Reusable attributes selected from the
                        Attribute Library.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        Manage attributes
                    </a>

                </div>
            </div>

        </div>

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5 fw-bold">
                        Projects
                    </h2>

                    <p class="text-secondary">
                        Maintain your professional projects
                        and technology tags.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        Manage projects
                    </a>

                </div>
            </div>

        </div>

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5 fw-bold">
                        CVs
                    </h2>

                    <p class="text-secondary">
                        View and manage CVs generated for
                        available positions.
                    </p>

                    <a href="#"
                       class="btn btn-outline-primary">
                        View CVs
                    </a>

                </div>
            </div>

        </div>

    </div>

</div>