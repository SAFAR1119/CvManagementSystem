@model CvManagementSystem.ViewModels.CandidateProfileViewModel

@{

    ViewData["Title"] = L["Profile"];

    var categories =

        ViewBag.AttributeCategories

        as IEnumerable<dynamic>

        ?? Enumerable.Empty<dynamic>();

    var attributeSearch =

        Model.AttributeSearch ?? string.Empty;

    var selectedCategoryId =

        Model.AttributeCategoryId;

    var isAdministratorView =

        Model.IsAdministratorView;

}

<div class="container py-4">

    <!-- ===================================================== -->

    <!-- Header -->

    <!-- ===================================================== -->

    <div class="d-flex flex-column flex-md-row

                justify-content-between

                align-items-md-center

                gap-3 mb-4">

        <div>

            <h1 class="h3 mb-1">

                @L["Profile"]

            </h1>

            <p class="text-muted mb-0">

                @L["PersonalProfile"]

            </p>

        </div>

        @if (!isAdministratorView)

        {

            <a asp-controller="Projects"

               asp-action="Index"

               class="btn btn-outline-primary">

                @L["MyProjects"]

            </a>

        }

    </div>


    <!-- ===================================================== -->

    <!-- Messages -->

    <!-- ===================================================== -->

    @if (TempData["SuccessMessage"] is string success)

    {

        <div class="alert alert-success">

            @success

        </div>

    }

    @if (TempData["ErrorMessage"] is string error)

    {

        <div class="alert alert-danger">

            @error

        </div>

    }


    <!-- ===================================================== -->

    <!-- Add Attribute -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h2 class="h5 mb-0">

                @L["AddProfileAttribute"]

            </h2>

        </div>

        <div class="card-body">

            <form asp-controller="Profile"

                  asp-action="Index"

                  method="get"

                  class="row g-3">

                <input type="hidden"

                       name="userId"

                       value="@Model.UserId" />

                <div class="col-md-6">

                    <label for="attributeSearch"

                           class="form-label">

                        @L["SearchAttributes"]

                    </label>

                    <input id="attributeSearch"

                           name="attributeSearch"

                           value="@attributeSearch"

                           class="form-control"

                           placeholder="@L["SearchAttributes"]" />

                </div>

                <div class="col-md-4">

                    <label for="attributeCategoryId"

                           class="form-label">

                        @L["AllCategories"]

                    </label>

                    <select id="attributeCategoryId"

                            name="attributeCategoryId"

                            class="form-select">

                        <option value="">

                            @L["AllCategories"]

                        </option>

                        @foreach (var category in categories)

                        {

                            <option value="@category.Id"

                                    selected="@(selectedCategoryId == (int?)category.Id)">

                                @category.Name

                            </option>

                        }

                    </select>

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"

                            class="btn btn-outline-primary w-100">

                        @L["Search"]

                    </button>

                </div>

            </form>


            @if (Model.AvailableAttributes.Count > 0)
            {
                <div class="table-responsive mt-4">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">
                                    @L["Select"]
                                </th>
                                <th>
                                    @L["Position"]
                                </th>
                                <th>
                                    @L["Category"]
                                </th>
                                <th>
                                    @L["DataType"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attribute in Model.AvailableAttributes)
                            {
                                <tr>
                                    <td>
                                        <input type="radio"
                                               name="availableAttributeSelection"
                                               class="form-check-input available-attribute-radio"
                                               value="@(attribute.Id)"
                                               aria-label="@(attribute.Name)" />
                                    </td>
                                    <td>
                                        @(attribute.Name)
                                    </td>
                                    <td>
                                        @(attribute.Category)
                                    </td>
                                    <td>
                                        @(attribute.DataType)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-top pt-3 mt-3">
                    <form asp-action="AddAttribute"
                          method="post"
                          id="add-attribute-form"
                          class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="attributeDefinitionId"
                               id="selected-attribute-definition-id"
                               value="" />

                        <input type="hidden"
                               name="userId"
                               value="@Model.UserId" />

                        <button type="submit"
                                id="add-selected-attribute"
                                class="btn btn-primary"
                                disabled>
                            @L["AddAttribute"]
                        </button>

                        <span id="attribute-selection-status"
                              class="small text-muted">
                            @L["SelectAttribute"]
                        </span>
                    </form>
                </div>
            }
            else
            {
                <div class="text-muted mt-3">
                    @L["NoAttributesSelected"]
                </div>
            }

        </div>

    </div>


    <!-- ===================================================== -->

    <!-- Main Profile Form -->

    <!-- ===================================================== -->

    <form asp-action="Save"

          method="post"

          id="profile-form">

        @Html.AntiForgeryToken()

        <input type="hidden"

               asp-for="Id" />

        <input type="hidden"

               asp-for="UserId" />

        <input type="hidden"

               asp-for="Version" />

               <!-- ================================================= -->

        <!-- Me -->

        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h2 class="h5 mb-0">

                    @L["Me"]

                </h2>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="FirstName"

                               class="form-label">

                            @L["FirstName"]

                        </label>

                        <input asp-for="FirstName"

                               class="form-control @(string.IsNullOrWhiteSpace(Model.FirstName)

                                   ? "border-danger"

                                   : "")" />

                        @if (string.IsNullOrWhiteSpace(Model.FirstName))

                        {

                            <div class="text-danger small mt-1">

                                @L["Required"]

                            </div>

                        }

                        <span asp-validation-for="FirstName"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="LastName"

                               class="form-label">

                            @L["LastName"]

                        </label>

                        <input asp-for="LastName"

                               class="form-control @(string.IsNullOrWhiteSpace(Model.LastName)

                                   ? "border-danger"

                                   : "")" />

                        @if (string.IsNullOrWhiteSpace(Model.LastName))

                        {

                            <div class="text-danger small mt-1">

                                @L["Required"]

                            </div>

                        }

                        <span asp-validation-for="LastName"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Location"

                               class="form-label">

                            @L["Location"]

                        </label>

                        <input asp-for="Location"

                               class="form-control" />

                        <span asp-validation-for="Location"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="PhotoUrl"

                               class="form-label">

                            @L["PersonalPhoto"]

                        </label>

                        <input asp-for="PhotoUrl"

                               class="form-control"

                               placeholder="https://..." />

                        <div class="form-text">

                            Use an external image URL. The application does not store image files on the web server.

                        </div>

                        <span asp-validation-for="PhotoUrl"

                              class="text-danger"></span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->

        <!-- Info -->

        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h2 class="h5 mb-0">

                    @L["Info"]

                </h2>

            </div>

            <div class="card-body p-0">

                @if (Model.Attributes.Count == 0)

                {

                    <div class="p-4 text-muted">

                        @L["NoAttributesSelected"]

                    </div>

                }

                else

                {

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th style="width: 45px;">

                                        <input type="checkbox"

                                               id="select-all-attributes"

                                               class="form-check-input" />

                                    </th>

                                    <th>

                                        @L["Position"]

                                    </th>

                                    <th>

                                        @L["Category"]

                                    </th>

                                    <th>

                                        @L["DataType"]

                                    </th>

                                    <th>

                                        @L["Value"]

                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @for (var i = 0;

                                     i < Model.Attributes.Count;

                                     i++)

                                {

                                    var item =

                                        Model.Attributes[i];

                                    <tr>

                                        <td>

                                            <input type="checkbox"

                                                   class="form-check-input attribute-checkbox"

                                                   value="@item.AttributeDefinitionId" />

                                        </td>

                                        <td>

                                            @(item.Name)

                                            <input type="hidden"

                                                   name="Attributes[@i].AttributeDefinitionId"

                                                   value="@item.AttributeDefinitionId" />

                                            <input type="hidden"

                                                   name="Attributes[@i].Version"

                                                   value="@item.Version" />

                                        </td>

                                        <td>

                                            @(item.Category)

                                        </td>

                                        <td>

                                            @item.DataType

                                        </td>

                                        <td>

                                            @switch (item.DataType)

                                            {

                                                case CvManagementSystem.Models.AttributeDataType.Boolean:

                                                    <div class="form-check">

                                                        <input type="hidden"

                                                               name="Attributes[@i].Value"

                                                               value="false" />

                                                        <input type="checkbox"

                                                               class="form-check-input"

                                                               name="Attributes[@i].Value"

                                                               value="true"

                                                               checked="@(item.Value == "true")" />

                                                    </div>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Dropdown:

                                                    <select name="Attributes[@i].Value"

                                                            class="form-select">

                                                        <option value="">

                                                            —

                                                        </option>

                                                        @foreach (var option

                                                            in item.Options)

                                                        {

                                                            <option value="@option.Value"

                                                                    selected="@(item.Value == option.Value)">

                                                                @option.Value

                                                            </option>

                                                        }

                                                    </select>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Text:

                                                    <textarea name="Attributes[@i].Value"

                                                              class="form-control"

                                                              rows="4">@item.Value</textarea>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Numeric:

                                                    <input type="number"

                                                           step="any"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Date:

                                                    <input type="date"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Period:

                                                    <input type="text"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control"

                                                           placeholder="YYYY-MM-DD - YYYY-MM-DD" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Image:

                                                    <input type="url"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control"

                                                           placeholder="https://..." />

                                                    break;

                                                default:

                                                    <input type="text"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                            }

                                            @if (string.IsNullOrWhiteSpace(item.Value))

                                            {

                                                <div class="text-danger small mt-1">

                                                    @L["Required"]

                                                </div>

                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>


                    <div class="border-top p-3">

                        <button type="button"

                                id="remove-selected-attributes"

                                class="btn btn-outline-danger btn-sm">

                            @L["RemoveSelected"]

                        </button>

                    </div>

                }

            </div>

        </div>


        <!-- ================================================= -->

        <!-- Save -->

        <!-- ================================================= -->

        <div class="d-flex flex-column flex-sm-row

                    align-items-sm-center

                    gap-3 mb-4">

            <button type="submit"

                    class="btn btn-primary">

                @L["SaveProfile"]

            </button>

            <span id="autosave-status"

                  class="small text-muted">

                @L["Saved"]

            </span>

        </div>

    </form>


    <!-- ===================================================== -->

    <!-- Projects -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex

                    justify-content-between

                    align-items-center">

            <div>

                <h2 class="h5 mb-0">

                    @L["Projects"]

                </h2>

                <p class="text-muted small mb-0 mt-1">

                    @L["ManageProjects"]

                </p>

            </div>

            <a asp-controller="Projects"

               asp-action="Index"

               class="btn btn-outline-primary btn-sm">

                @L["MyProjects"]

            </a>

        </div>

        <div class="card-body p-0">

            @if (Model.Projects.Count == 0)

            {

                <div class="p-4 text-muted">

                    @L["NoProjects"]

                </div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-hover

                                  align-middle

                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    @L["Project"]

                                </th>

                                <th>

                                    @L["Period"]

                                </th>

                                <th>

                                    @L["TechnologyTags"]

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var project in Model.Projects)

                            {

                                <tr>

                                    <td>

                                        <a asp-controller="Projects"

                                           asp-action="Details"

                                           asp-route-id="@project.Id"

                                           class="fw-semibold text-decoration-none">

                                            @(project.Name)

                                        </a>

                                    </td>

                                    <td>

                                        @(project.Period)

                                    </td>

                                    <td>

                                        @if (project.TechnologyTags.Count == 0)

                                        {

                                            <span class="text-muted">

                                                —

                                            </span>

                                        }

                                        else

                                        {

                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var projectTag

                                                    in project.TechnologyTags)

                                                {

                                                    <span class="badge

                                                                 text-bg-light

                                                                 border">

                                                        @projectTag

                                                    </span>

                                                }

                                            </div>

                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>


    <!-- ===================================================== -->

    <!-- CVs -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex

                    justify-content-between

                    align-items-center">

            <div>

                <h2 class="h5 mb-0">

                    @L["MyCVs"]

                </h2>

                <p class="text-muted small mb-0 mt-1">

                    @L["CreateCVFromPosition"]

                </p>

            </div>

            <a asp-controller="Positions"

               asp-action="Index"

               class="btn btn-outline-primary btn-sm">

                @L["BrowsePositions"]

            </a>

        </div>


        <div class="card-body p-0">

            @if (Model.Cvs.Count == 0)

            {

                <div class="p-4 text-center">

                    <h3 class="h6">

                        @L["NoCVs"]

                    </h3>

                    <p class="text-muted mb-0">

                        @L["CreateCVFromPosition"]

                    </p>

                </div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-hover

                                  align-middle

                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    @L["CVs"]

                                </th>

                                <th>

                                    @L["Position"]

                                </th>

                                <th>

                                    @L["Status"]

                                </th>

                                <th>

                                    @L["Updated"]

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var cv in Model.Cvs)

                            {

                                <tr>

                                    <td>

                                        <a asp-controller="Cvs"

                                           asp-action="Details"

                                           asp-route-id="@cv.Id"

                                           class="fw-semibold text-decoration-none">

                                            @(cv.Title)

                                        </a>

                                    </td>

                                    <td>

                                        @(cv.PositionTitle)

                                    </td>

                                    <td>

                                        @if (cv.IsPublished)

                                        {

                                            <span class="badge text-bg-success">

                                                @L["Published"]

                                            </span>

                                        }

                                        else

                                        {

                                            <span class="badge text-bg-secondary">

                                                @L["Draft"]

                                            </span>

                                        }

                                    </td>

                                    <td>

                                        @cv.UpdatedAt

                                            .ToLocalTime()

                                            .ToString("dd MMM yyyy, HH\:mm")

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>


<!-- ========================================================= -->

<!-- Profile JavaScript -->

<!-- ========================================================= -->

<script>

    (() => {

        // -----------------------------------------------------
        // Available attribute selection
        // -----------------------------------------------------
        const availableAttributeRadios =
            Array.from(
                document.querySelectorAll(".available-attribute-radio")
            );

        const selectedAttributeDefinitionInput =
            document.getElementById("selected-attribute-definition-id");

        const addSelectedAttributeButton =
            document.getElementById("add-selected-attribute");

        const attributeSelectionStatus =
            document.getElementById("attribute-selection-status");

        availableAttributeRadios.forEach(radio => {
            radio.addEventListener("change", () => {
                if (selectedAttributeDefinitionInput) {
                    selectedAttributeDefinitionInput.value = radio.value;
                }

                if (addSelectedAttributeButton) {
                    addSelectedAttributeButton.disabled = false;
                }

                if (attributeSelectionStatus) {
                    attributeSelectionStatus.textContent =
                        radio.getAttribute("aria-label") || "";
                }
            });
        });

        // -----------------------------------------------------
        // Selected profile attributes
        // -----------------------------------------------------
        const selectAllAttributes =

            document.getElementById(

                "select-all-attributes"

            );

        const attributeCheckboxes =

            Array.from(

                document.querySelectorAll(

                    ".attribute-checkbox"

                )

            );

        const removeAttributesButton =

            document.getElementById(

                "remove-selected-attributes"

            );


        function selectedAttributeIds() {

            return attributeCheckboxes

                .filter(x => x.checked)

                .map(x => Number(x.value));

        }


        if (selectAllAttributes) {

            selectAllAttributes.addEventListener(

                "change",

                () => {

                    attributeCheckboxes.forEach(

                        checkbox => {

                            checkbox.checked =

                                selectAllAttributes.checked;

                        }

                    );

                }

            );

        }


        if (removeAttributesButton) {

            removeAttributesButton.addEventListener(

                "click",

                async () => {

                    const ids =

                        selectedAttributeIds();

                    if (ids.length === 0) {

                        return;

                    }

                    const formData =

                        new FormData();

                    formData.append(

                        "__RequestVerificationToken",

                        document.querySelector(

                            '#profile-form input[name="__RequestVerificationToken"]'

                        )?.value || ""

                    );

                    formData.append(

                        "userId",

                        "@Model.UserId"

                    );

                    ids.forEach(

                        id => {

                            formData.append(

                                "attributeIds",

                                id

                            );

                        }

                    );


                    const response =

                        await fetch(

                            "@Url.Action("RemoveAttribute", "Profile")",

                            {

                                method: "POST",

                                body: formData

                            }

                        );


                    if (response.ok) {

                        window.location.reload();

                    }

                }

            );

        }


        // -----------------------------------------------------

        // Autosave

        // -----------------------------------------------------

        const profileForm =

            document.getElementById(

                "profile-form"

            );

        const autosaveStatus =

            document.getElementById(

                "autosave-status"

            );

        if (!profileForm || !autosaveStatus) {

            return;

        }


        let dirty = false;

        let saving = false;


        function setStatus(text) {

            autosaveStatus.textContent =

                text;

        }


        function markDirty() {

            dirty = true;

            setStatus(

                "@Html.Raw(L["UnsavedChanges"].Value)"

            );

        }


        profileForm.addEventListener(

            "input",

            markDirty

        );

        profileForm.addEventListener(

            "change",

            markDirty

        );


        async function autoSave() {

            if (!dirty || saving) {

                return;

            }

            saving = true;

            setStatus(

                "@Html.Raw(L["Saving"].Value)"

            );


            try {

                const formData =

                    new FormData(profileForm);


                const response =

                    await fetch(

                        "@Url.Action("AutoSave", "Profile")",

                        {

                            method: "POST",

                            body: formData

                        }

                    );


                if (response.status === 409) {

                    const result =

                        await response.json();

                    setStatus(

                        result.message ||

                        "@Html.Raw(L["SaveConflict"].Value)"

                    );

                    return;

                }


                if (!response.ok) {

                    setStatus(

                        "Auto-save failed."

                    );

                    return;

                }


                const result =

                    await response.json();


                if (!result.success) {

                    setStatus(

                        result.message ||

                        "Auto-save failed."

                    );

                    return;

                }


                const profileVersionInput =

                    profileForm.querySelector(

                        'input[name="Version"]'

                    );

                if (

                    profileVersionInput &&

                    result.profileVersion

                ) {

                    profileVersionInput.value =

                        result.profileVersion;

                }


                if (result.attributeVersions) {

                    const attributeIdInputs =

                        profileForm.querySelectorAll(

                            'input[name$=".AttributeDefinitionId"]'

                        );


                    attributeIdInputs.forEach(

                        attributeIdInput => {

                            const match =

                                attributeIdInput.name.match(

                                    /Attributes\[(\d+)\]\.AttributeDefinitionId/

                                );

                            if (!match) {

                                return;

                            }


                            const index =

                                match[1];

                            const attributeId =

                                Number(

                                    attributeIdInput.value

                                );


                            const newVersion =

                                result.attributeVersions[

                                    attributeId

                                ];


                            if (!newVersion) {

                                return;

                            }


                            const versionInput =

                                profileForm.querySelector(

                                    \`input[name="Attributes[${index}].Version"]\`

                                );


                            if (versionInput) {

                                versionInput.value =

                                    newVersion;

                            }

                        }

                    );

                }


                dirty = false;

                setStatus(

                    "@Html.Raw(L["AutoSaved"].Value)"

                );

            }

            catch (error) {

                console.error(

                    "Profile auto-save failed:",

                    error

                );

                setStatus(

                    "Auto-save failed."

                );

            }

            finally {

                saving = false;

            }

        }


        // Seven seconds is within the required 5-10 second interval.

        setInterval(

            autoSave,

            7000

        );

    })();

</script>