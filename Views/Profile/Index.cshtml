@model CvManagementSystem.ViewModels.CandidateProfileViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{

    ViewData["Title"] = L["Profile"];

    var categories =

        ViewBag.AttributeCategories

        as IEnumerable<dynamic>

        ?? Enumerable.Empty<dynamic>();

    var attributeSearch =

        Model.AttributeSearch ?? string.Empty;

    var selectedCategoryId =

        Model.AttributeCategoryId;

    var isAdministratorView =

        Model.IsAdministratorView;

}

<div class="container py-4">

    <!-- ===================================================== -->

    <!-- Header -->

    <!-- ===================================================== -->

    <div class="d-flex flex-column flex-md-row

                justify-content-between

                align-items-md-center

                gap-3 mb-4">

        <div>

            <h1 class="h3 mb-1">

                @L["Profile"]

            </h1>

            <p class="text-muted mb-0">

                @L["PersonalProfile"]

            </p>

        </div>

        @if (!isAdministratorView)

        {

            <a asp-controller="Projects"

               asp-action="Index"

               class="btn btn-outline-primary">

                @L["MyProjects"]

            </a>

        }

    </div>


    <!-- ===================================================== -->

    <!-- Messages -->

    <!-- ===================================================== -->

    @if (TempData["SuccessMessage"] is string success)

    {

        <div class="alert alert-success">

            @success

        </div>

    }

    @if (TempData["ErrorMessage"] is string error)

    {

        <div class="alert alert-danger">

            @error

        </div>

    }


    <!-- ===================================================== -->

    <!-- Add Attribute -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h2 class="h5 mb-0">

                @L["AddProfileAttribute"]

            </h2>

        </div>

        <div class="card-body">

            <form asp-controller="Profile"

                  asp-action="Index"

                  method="get"

                  class="row g-3">

                <input type="hidden"

                       name="userId"

                       value="@Model.UserId" />

                <div class="col-md-6">

                    <label for="attributeSearch"

                           class="form-label">

                        @L["SearchAttributes"]

                    </label>

                    <input id="attributeSearch"

                           name="attributeSearch"

                           value="@attributeSearch"

                           class="form-control"

                           placeholder="@L["SearchAttributes"]" />

                </div>

                <div class="col-md-4">

                    <label for="attributeCategoryId"

                           class="form-label">

                        @L["Category"]

                    </label>

                    <select id="attributeCategoryId"

                            name="attributeCategoryId"

                            class="form-select">

                        <option value="">

                            @L["AllCategories"]

                        </option>

                        @foreach (var category in categories)

                        {

                            <option value="@category.Id"

                                    selected="@(selectedCategoryId == (int?)category.Id)">

                                @category.Name

                            </option>

                        }

                    </select>

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"

                            class="btn btn-outline-primary w-100">

                        @L["Search"]

                    </button>

                </div>

            </form>


            @if (Model.AvailableAttributes.Count > 0)
            {
                <div class="table-responsive mt-4">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">
                                    @L["Select"]
                                </th>
                                <th>
                                    @L["Position"]
                                </th>
                                <th>
                                    @L["Category"]
                                </th>
                                <th>
                                    @L["DataType"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attribute in Model.AvailableAttributes)
                            {
                                <tr>
                                    <td>
                                        <input type="radio"
                                               name="availableAttributeSelection"
                                               class="form-check-input available-attribute-radio"
                                               value="@(attribute.Id)"
                                               aria-label="@(attribute.Name)" />
                                    </td>
                                    <td>
                                        @(attribute.Name)
                                    </td>
                                    <td>
                                        @(attribute.Category)
                                    </td>
                                    <td>
                                        @(attribute.DataType)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-top pt-3 mt-3">
                    <form asp-action="AddAttribute"
                          method="post"
                          id="add-attribute-form"
                          class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="attributeDefinitionId"
                               id="selected-attribute-definition-id"
                               value="" />

                        <input type="hidden"
                               name="userId"
                               value="@Model.UserId" />

                        <button type="submit"
                                id="add-selected-attribute"
                                class="btn btn-primary"
                                disabled>
                            @L["AddAttribute"]
                        </button>

                        <span id="attribute-selection-status"
                              class="small text-muted">
                            @L["SelectAttribute"]
                        </span>
                    </form>
                </div>
            }
            else
            {
                <div class="text-muted mt-3">
                    @L["NoAvailableAttributes"]
                </div>
            }

        </div>

    </div>


    <!-- ===================================================== -->

    <!-- Main Profile Form -->

    <!-- ===================================================== -->

    <form asp-action="Save"

          method="post"

          id="profile-form">

        @Html.AntiForgeryToken()

        <input type="hidden"

               asp-for="Id" />

        <input type="hidden"

               asp-for="UserId" />

        <input type="hidden"

               asp-for="Version" />

               <!-- ================================================= -->

        <!-- Me -->

        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h2 class="h5 mb-0">

                    @L["Me"]

                </h2>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="FirstName"

                               class="form-label">

                            @L["FirstName"]

                        </label>

                        <input asp-for="FirstName"

                               class="form-control @(string.IsNullOrWhiteSpace(Model.FirstName)

                                   ? "border-danger"

                                   : "")" />

                        @if (string.IsNullOrWhiteSpace(Model.FirstName))

                        {

                            <div class="text-danger small mt-1">

                                @L["Required"]

                            </div>

                        }

                        <span asp-validation-for="FirstName"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="LastName"

                               class="form-label">

                            @L["LastName"]

                        </label>

                        <input asp-for="LastName"

                               class="form-control @(string.IsNullOrWhiteSpace(Model.LastName)

                                   ? "border-danger"

                                   : "")" />

                        @if (string.IsNullOrWhiteSpace(Model.LastName))

                        {

                            <div class="text-danger small mt-1">

                                @L["Required"]

                            </div>

                        }

                        <span asp-validation-for="LastName"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Location"

                               class="form-label">

                            @L["Location"]

                        </label>

                        <input asp-for="Location"

                               class="form-control" />

                        <span asp-validation-for="Location"

                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="PhotoUrl"

                               class="form-label">

                            @L["PersonalPhoto"]

                        </label>

                        <input asp-for="PhotoUrl"

                               class="form-control"

                               placeholder="https://..." />

                        <div class="form-text">

                            Use an external image URL. The application does not store image files on the web server.

                        </div>

                        <span asp-validation-for="PhotoUrl"

                              class="text-danger"></span>

                    </div>

                </div>

                @if (Model.Id != 0)
                {
                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">@L["Achievements"]</h6>

                        <a asp-action="DownloadBadges"
                           asp-route-userId="@(Model.IsAdministratorView ? Model.UserId : null)"
                           class="btn btn-sm btn-outline-secondary">
                            @L["DownloadBadgesSvg"]
                        </a>
                    </div>

                    @await Html.PartialAsync("_BadgePanel", Model.Badges)
                }

            </div>

        </div>


        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Professional Profile</h2></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="ProfessionalTitle" class="form-label"></label><input asp-for="ProfessionalTitle" class="form-control" placeholder="e.g. Junior Software Engineer" /></div>
                    <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="LinkedInUrl" class="form-label"></label><input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." /></div>
                    <div class="col-md-6"><label asp-for="GitHubUrl" class="form-label"></label><input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/..." /></div>
                    <div class="col-md-6"><label asp-for="PortfolioUrl" class="form-label"></label><input asp-for="PortfolioUrl" class="form-control" placeholder="https://..." /></div>
                    <div class="col-12"><label asp-for="ProfessionalSummary" class="form-label"></label><textarea asp-for="ProfessionalSummary" class="form-control" rows="4" placeholder="A concise introduction that will appear on your CV."></textarea></div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Work Experience</h2>
        <div class="small text-muted">
            Add the roles you'd like recruiters to see, most recent first.
        </div>
    </div>

    <div class="card-body">

        <div id="work-experience-entries">
            @for (var i = 0; i < Model.WorkExperiences.Count; i++)
            {
                var item = Model.WorkExperiences[i];

                <fieldset class="border rounded p-3 mb-3 entry-fieldset">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <legend class="float-none w-auto px-0 fs-6 mb-0 entry-legend">
                            Experience @(i + 1)
                        </legend>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-entry-btn">
                            Remove
                        </button>
                    </div>

                    <input type="hidden"
                           name="WorkExperiences[@i].Id"
                           value="@item.Id" />

                    <input type="hidden"
                           name="WorkExperiences[@i].SortOrder"
                           value="@item.SortOrder" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Company / Organization
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].CompanyName"
                                   value="@item.CompanyName"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Job Title
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].JobTitle"
                                   value="@item.JobTitle"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Start Date
                            </label>
                            <input type="date"
                                   name="WorkExperiences[@i].StartDate"
                                   value="@item.StartDate.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                End Date
                            </label>
                            <input type="date"
                                   name="WorkExperiences[@i].EndDate"
                                   value="@(item.EndDate?.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                            <div class="form-text">
                                Leave blank if this is your current role.
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Responsibilities / Achievements
                            </label>
                            <textarea name="WorkExperiences[@i].Description"
                                      class="form-control"
                                      rows="3">@item.Description</textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Technologies Used
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].Technologies"
                                   value="@item.Technologies"
                                   class="form-control"
                                   placeholder="Java, Spring Boot, MySQL, TypeScript" />
                        </div>

                    </div>
                </fieldset>
            }

            @if (Model.WorkExperiences.Count == 0)
            {
                var i = 0;

                <fieldset class="border rounded p-3 mb-3 entry-fieldset">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <legend class="float-none w-auto px-0 fs-6 mb-0 entry-legend">
                            Experience @(i + 1)
                        </legend>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-entry-btn">
                            Remove
                        </button>
                    </div>

                    <input type="hidden"
                           name="WorkExperiences[@i].Id"
                           value="0" />

                    <input type="hidden"
                           name="WorkExperiences[@i].SortOrder"
                           value="0" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Company / Organization
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].CompanyName"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Job Title
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].JobTitle"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Start Date
                            </label>
                            <input type="date"
                                   name="WorkExperiences[@i].StartDate"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                End Date
                            </label>
                            <input type="date"
                                   name="WorkExperiences[@i].EndDate"
                                   class="form-control" />
                            <div class="form-text">
                                Leave blank if this is your current role.
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Responsibilities / Achievements
                            </label>
                            <textarea name="WorkExperiences[@i].Description"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Technologies Used
                            </label>
                            <input type="text"
                                   name="WorkExperiences[@i].Technologies"
                                   class="form-control"
                                   placeholder="Java, Spring Boot, MySQL, TypeScript" />
                        </div>

                    </div>
                </fieldset>
            }
        </div>

        <button type="button"
                id="add-work-experience"
                class="btn btn-outline-primary btn-sm">
            + Add Work Experience
        </button>

    </div>
</div>

