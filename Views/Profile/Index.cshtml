        <!-- ================================================= -->

        <!-- Info -->

        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h2 class="h5 mb-0">

                    @L["Info"]

                </h2>

            </div>

            <div class="card-body p-0">

                @if (Model.Attributes.Count == 0)

                {

                    <div class="p-4 text-muted">

                        @L["NoAttributesSelected"]

                    </div>

                }

                else

                {

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th style="width: 45px;">

                                        <input type="checkbox"

                                               id="select-all-attributes"

                                               class="form-check-input" />

                                    </th>

                                    <th>

                                        @L["Position"]

                                    </th>

                                    <th>

                                        @L["Category"]

                                    </th>

                                    <th>

                                        @L["DataType"]

                                    </th>

                                    <th>

                                        @L["Value"]

                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @for (var i = 0;

                                     i < Model.Attributes.Count;

                                     i++)

                                {

                                    var item =

                                        Model.Attributes[i];

                                    <tr>

                                        <td>

                                            <input type="checkbox"

                                                   class="form-check-input attribute-checkbox"

                                                   value="@item.AttributeDefinitionId" />

                                        </td>

                                        <td>

                                            @(item.Name)

                                            <input type="hidden"

                                                   name="Attributes[@i].AttributeDefinitionId"

                                                   value="@item.AttributeDefinitionId" />

                                            <input type="hidden"

                                                   name="Attributes[@i].Version"

                                                   value="@item.Version" />

                                        </td>

                                        <td>

                                            @(item.Category)

                                        </td>

                                        <td>

                                            @item.DataType

                                        </td>

                                        <td>

                                            @switch (item.DataType)

                                            {

                                                case CvManagementSystem.Models.AttributeDataType.Boolean:

                                                    <div class="form-check">

                                                        <input type="hidden"

                                                               name="Attributes[@i].Value"

                                                               value="false" />

                                                        <input type="checkbox"

                                                               class="form-check-input"

                                                               name="Attributes[@i].Value"

                                                               value="true"

                                                               checked="@(item.Value == "true")" />

                                                    </div>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Dropdown:

                                                    <select name="Attributes[@i].Value"

                                                            class="form-select">

                                                        <option value="">

                                                            —

                                                        </option>

                                                        @foreach (var option

                                                            in item.Options)

                                                        {

                                                            <option value="@option.Value"

                                                                    selected="@(item.Value == option.Value)">

                                                                @option.Value

                                                            </option>

                                                        }

                                                    </select>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Text:

                                                    <textarea name="Attributes[@i].Value"

                                                              class="form-control"

                                                              rows="4">@item.Value</textarea>

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Numeric:

                                                    <input type="number"

                                                           step="any"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Date:

                                                    <input type="date"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Period:

                                                    <input type="text"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control"

                                                           placeholder="YYYY-MM-DD - YYYY-MM-DD" />

                                                    break;

                                                case CvManagementSystem.Models.AttributeDataType.Image:

                                                    <input type="url"

                                                           id="attribute-image-@i"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control"

                                                           placeholder="https://..." />

                                                    <div class="cloud-image-dropzone border rounded p-3 mt-2 text-center"
                                                         data-input-id="attribute-image-@i"
                                                         data-cloud-name="@Configuration["Cloudinary:CloudName"]"
                                                         data-upload-preset="@Configuration["Cloudinary:UploadPreset"]"
                                                         tabindex="0">
                                                        <input type="file" accept="image/*" class="d-none cloud-image-file" />
                                                        <div class="small text-muted">Drag an image here, or <button type="button" class="btn btn-link btn-sm p-0 cloud-image-browse">choose a file</button>. Images are uploaded directly to configured cloud storage.</div>
                                                        <div class="small mt-1 cloud-image-status"></div>
                                                    </div>

                                                    break;

                                                default:

                                                    <input type="text"

                                                           name="Attributes[@i].Value"

                                                           value="@item.Value"

                                                           class="form-control" />

                                                    break;

                                            }

                                            @if (string.IsNullOrWhiteSpace(item.Value))

                                            {

                                                <div class="text-danger small mt-1">

                                                    @L["Required"]

                                                </div>

                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>


                    <div class="border-top p-3">

                        <button type="button"

                                id="remove-selected-attributes"

                                class="btn btn-outline-danger btn-sm">

                            @L["RemoveSelected"]

                        </button>

                    </div>

                }

            </div>

        </div>


        <!-- ================================================= -->

        <!-- Save -->

        <!-- ================================================= -->

        <div class="d-flex flex-column flex-sm-row

                    align-items-sm-center

                    gap-3 mb-4">

            <button type="submit"

                    class="btn btn-primary">

                @L["SaveProfile"]

            </button>

            <span id="autosave-status"

                  class="small text-muted">

                @L["Saved"]

            </span>

        </div>

    </form>


    <!-- ===================================================== -->

    <!-- Projects -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex

                    justify-content-between

                    align-items-center">

            <div>

                <h2 class="h5 mb-0">

                    @L["Projects"]

                </h2>

                <p class="text-muted small mb-0 mt-1">

                    @L["ManageProjects"]

                </p>

            </div>

            <a asp-controller="Projects"

               asp-action="Index"

               class="btn btn-outline-primary btn-sm">

                @L["MyProjects"]

            </a>

        </div>

        <div class="card-body p-0">

            @if (Model.Projects.Count == 0)

            {

                <div class="p-4 text-muted">

                    @L["NoProjects"]

                </div>

            }

            else

            {

                <div class="table-responsive">

                    <table class="table table-hover

                                  align-middle

                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    @L["Project"]

                                </th>

                                <th>

                                    @L["Period"]

                                </th>

                                <th>

                                    @L["TechnologyTags"]

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var project in Model.Projects)

                            {

                                <tr>

                                    <td>

                                        <a asp-controller="Projects"

                                           asp-action="Details"

                                           asp-route-id="@project.Id"

                                           class="fw-semibold text-decoration-none">

                                            @(project.Name)

                                        </a>

                                    </td>

                                    <td>

                                        @(project.Period)

                                    </td>

                                    <td>

                                        @if (project.TechnologyTags.Count == 0)

                                        {

                                            <span class="text-muted">

                                                —

                                            </span>

                                        }

                                        else

                                        {

                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var projectTag

                                                    in project.TechnologyTags)

                                                {

                                                    <span class="badge

                                                                 text-bg-light

                                                                 border">

                                                        @projectTag

                                                    </span>

                                                }

                                            </div>

                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>


    <!-- ===================================================== -->

    <!-- CVs -->

    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex

                    justify-content-between

                    align-items-center">

            <div>

                <h2 class="h5 mb-0">

                    @L["MyCVs"]

                </h2>

                <p class="text-muted small mb-0 mt-1">

                    @L["CreateCVFromPosition"]

                </p>

            </div>

            <a asp-controller="Positions"

               asp-action="Index"

               class="btn btn-outline-primary btn-sm">

                @L["BrowsePositions"]

            </a>

        </div>


        <div class="card-body p-0">

            @if (Model.Cvs.Count == 0)

            {

                <div class="p-4 text-center">

                    <h3 class="h6">

                        @L["NoCVs"]

                    </h3>

                    <p class="text-muted mb-0">

                        @L["CreateCVFromPosition"]

                    </p>

                </div>

            }

            else

            {

                <form asp-controller="Cvs"
                      asp-action="DeleteSelected"
                      method="post"
                      id="cv-list-form">

                    @Html.AntiForgeryToken()

                    <div class="d-flex align-items-center gap-2 px-3 pt-3">

                        <button type="submit"
                                id="delete-selected-cvs"
                                class="btn btn-outline-danger btn-sm"
                                disabled
                                onclick="return confirm('Delete the selected CV(s)? This cannot be undone.')">
                            @L["RemoveSelected"]
                        </button>

                        <span id="cv-selection-status"
                              class="small text-muted">
                        </span>

                    </div>

                <div class="table-responsive">

                    <table class="table table-hover

                                  align-middle

                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width: 45px;">

                                    <input type="checkbox"
                                           id="select-all-cvs"
                                           class="form-check-input" />

                                </th>

                                <th>

                                    @L["CVs"]

                                </th>

                                <th>

                                    @L["Position"]

                                </th>

                                <th>

                                    @L["Status"]

                                </th>

                                <th>

                                    @L["Updated"]

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var cv in Model.Cvs)

                            {

                                <tr>

                                    <td>

                                        <input type="checkbox"
                                               class="form-check-input cv-checkbox"
                                               name="selectedIds"
                                               value="@cv.Id" />

                                    </td>

                                    <td>

                                        <a asp-controller="Cvs"

                                           asp-action="Details"

                                           asp-route-id="@cv.Id"

                                           class="fw-semibold text-decoration-none">

                                            @(cv.Title)

                                        </a>

                                    </td>

                                    <td>

                                        @(cv.PositionTitle)

                                    </td>

                                    <td>

                                        @if (cv.IsPublished)

                                        {

                                            <span class="badge text-bg-success">

                                                @L["Published"]

                                            </span>

                                        }

                                        else

                                        {

                                            <span class="badge text-bg-secondary">

                                                @L["Draft"]

                                            </span>

                                        }

                                    </td>

                                    <td>

                                        @cv.UpdatedAt

                                            .ToLocalTime()

                                            .ToString("dd MMM yyyy, HH\:mm")

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

                </form>

            }

        </div>

    </div>

</div>


<!-- ========================================================= -->

<!-- Profile JavaScript -->

<!-- ========================================================= -->

<script>

    (() => {

        // -----------------------------------------------------
        // Available attribute selection
        // -----------------------------------------------------
        const availableAttributeRadios =
            Array.from(
                document.querySelectorAll(".available-attribute-radio")
            );

        const selectedAttributeDefinitionInput =
            document.getElementById("selected-attribute-definition-id");

        const addSelectedAttributeButton =
            document.getElementById("add-selected-attribute");

        const attributeSelectionStatus =
            document.getElementById("attribute-selection-status");

        availableAttributeRadios.forEach(radio => {
            radio.addEventListener("change", () => {
                if (selectedAttributeDefinitionInput) {
                    selectedAttributeDefinitionInput.value = radio.value;
                }

                if (addSelectedAttributeButton) {
                    addSelectedAttributeButton.disabled = false;
                }

                if (attributeSelectionStatus) {
                    attributeSelectionStatus.textContent =
                        radio.getAttribute("aria-label") || "";
                }
            });
        });

        // -----------------------------------------------------
        // Selected profile attributes
        // -----------------------------------------------------
        const selectAllAttributes =

            document.getElementById(

                "select-all-attributes"

            );

        const attributeCheckboxes =

            Array.from(

                document.querySelectorAll(

                    ".attribute-checkbox"

                )

            );

        const removeAttributesButton =

            document.getElementById(

                "remove-selected-attributes"

            );


        function selectedAttributeIds() {

            return attributeCheckboxes

                .filter(x => x.checked)

                .map(x => Number(x.value));

        }


        if (selectAllAttributes) {

            selectAllAttributes.addEventListener(

                "change",

                () => {

                    attributeCheckboxes.forEach(

                        checkbox => {

                            checkbox.checked =

                                selectAllAttributes.checked;

                        }

                    );

                }

            );

        }


        if (removeAttributesButton) {

            removeAttributesButton.addEventListener(

                "click",

                async () => {

                    const ids =

                        selectedAttributeIds();

                    if (ids.length === 0) {

                        return;

                    }

                    const formData =

                        new FormData();

                    formData.append(

                        "__RequestVerificationToken",

                        document.querySelector(

                            '#profile-form input[name="__RequestVerificationToken"]'

                        )?.value || ""

                    );

                    formData.append(

                        "userId",

                        "@Model.UserId"

                    );

                    ids.forEach(

                        id => {

                            formData.append(

                                "attributeIds",

                                id

                            );

                        }

                    );


                    const response =

                        await fetch(

                            "@Url.Action("RemoveAttribute", "Profile")",

                            {

                                method: "POST",

                                body: formData

                            }

                        );


                    if (response.ok) {

                        window.location.reload();

                    }

                }

            );

        }


        // -----------------------------------------------------
        // CV list: bulk selection for delete
        // -----------------------------------------------------
        const selectAllCvs =
            document.getElementById("select-all-cvs");

        const cvCheckboxes =
            Array.from(
                document.querySelectorAll(".cv-checkbox")
            );

        const deleteSelectedCvsButton =
            document.getElementById("delete-selected-cvs");

        const cvSelectionStatus =
            document.getElementById("cv-selection-status");

        function updateCvSelectionState() {
            const count =
                cvCheckboxes.filter(x => x.checked).length;

            if (deleteSelectedCvsButton) {
                deleteSelectedCvsButton.disabled = count === 0;
            }

            if (cvSelectionStatus) {
                cvSelectionStatus.textContent =
                    count > 0 ? `${count} selected` : "";
            }
        }

        if (selectAllCvs) {
            selectAllCvs.addEventListener("change", () => {
                cvCheckboxes.forEach(checkbox => {
                    checkbox.checked = selectAllCvs.checked;
                });

                updateCvSelectionState();
            });
        }

        cvCheckboxes.forEach(checkbox => {
            checkbox.addEventListener("change", () => {
                if (!checkbox.checked && selectAllCvs) {
                    selectAllCvs.checked = false;
                }

                updateCvSelectionState();
            });
        });


        // -----------------------------------------------------
        // Work experience / education: add & remove entries
        // -----------------------------------------------------
        function setupDynamicEntries(containerId, addButtonId, templateId, namePrefix, legendLabel) {
            const container = document.getElementById(containerId);
            const addButton = document.getElementById(addButtonId);
            const template = document.getElementById(templateId);

            if (!container || !addButton || !template) {
                return;
            }

            function notifyFormChanged() {
                document.getElementById("profile-form")
                    ?.dispatchEvent(new Event("change", { bubbles: true }));
            }

            function reindex() {
                const entries = Array.from(container.querySelectorAll(":scope > .entry-fieldset"));

                entries.forEach((entry, index) => {
                    const legend = entry.querySelector(".entry-legend");
                    if (legend) {
                        legend.textContent = `${legendLabel} ${index + 1}`;
                    }

                    entry.querySelectorAll("[name]").forEach(field => {
                        field.name = field.name.replace(
                            new RegExp(`^${namePrefix}\\[\\d+\\]`),
                            `${namePrefix}[${index}]`
                        );
                    });
                });
            }

            function attachRemoveHandler(entry) {
                const removeButton = entry.querySelector(".remove-entry-btn");
                if (!removeButton) {
                    return;
                }

                removeButton.addEventListener("click", () => {
                    entry.remove();
                    reindex();
                    notifyFormChanged();
                });
            }

            container.querySelectorAll(":scope > .entry-fieldset")
                .forEach(attachRemoveHandler);

            addButton.addEventListener("click", () => {
                const fragment = template.content.cloneNode(true);
                const entry = fragment.querySelector(".entry-fieldset");

                container.appendChild(entry);
                attachRemoveHandler(entry);
                reindex();
                notifyFormChanged();

                entry.querySelector("input, textarea, select")?.focus();
            });
        }

        setupDynamicEntries(
            "work-experience-entries",
            "add-work-experience",
            "work-experience-template",
            "WorkExperiences",
            "Experience"
        );

        setupDynamicEntries(
            "education-entries",
            "add-education",
            "education-template",
            "EducationEntries",
            "Education"
        );


        // -----------------------------------------------------

        // Autosave

        // -----------------------------------------------------

        const profileForm =

            document.getElementById(

                "profile-form"

            );

        const autosaveStatus =

            document.getElementById(

                "autosave-status"

            );

        if (!profileForm || !autosaveStatus) {

            return;

        }


        let dirty = false;

        let saving = false;


        function setStatus(text) {

            autosaveStatus.textContent =

                text;

        }


        function markDirty() {

            dirty = true;

            setStatus(

                "@Html.Raw(L["UnsavedChanges"].Value)"

            );

        }


        profileForm.addEventListener(

            "input",

            markDirty

        );

        profileForm.addEventListener(

            "change",

            markDirty

        );


        async function autoSave() {

            if (!dirty || saving) {

                return;

            }

            saving = true;

            setStatus(

                "@Html.Raw(L["Saving"].Value)"

            );


            try {

                const formData =

                    new FormData(profileForm);


                const response =

                    await fetch(

                        "@Url.Action("AutoSave", "Profile")",

                        {

                            method: "POST",

                            body: formData

                        }

                    );


                if (response.status === 409) {

                    const result =

                        await response.json();

                    setStatus(

                        result.message ||

                        "@Html.Raw(L["SaveConflict"].Value)"

                    );

                    return;

                }


                if (!response.ok) {

                    setStatus(

                        "Auto-save failed."

                    );

                    return;

                }


                const result =

                    await response.json();


                if (!result.success) {

                    setStatus(

                        result.message ||

                        "Auto-save failed."

                    );

                    return;

                }


                const profileVersionInput =

                    profileForm.querySelector(

                        'input[name="Version"]'

                    );

                if (

                    profileVersionInput &&

                    result.profileVersion

                ) {

                    profileVersionInput.value =

                        result.profileVersion;

                }


                if (result.attributeVersions) {

                    const attributeIdInputs =

                        profileForm.querySelectorAll(

                            'input[name$=".AttributeDefinitionId"]'

                        );


                    attributeIdInputs.forEach(

                        attributeIdInput => {

                            const match =

                                attributeIdInput.name.match(

                                    /Attributes\[(\d+)\]\.AttributeDefinitionId/

                                );

                            if (!match) {

                                return;

                            }


                            const index =

                                match[1];

                            const attributeId =

                                Number(

                                    attributeIdInput.value

                                );


                            const newVersion =

                                result.attributeVersions[

                                    attributeId

                                ];


                            if (!newVersion) {

                                return;

                            }


                            const versionInput =

                                profileForm.querySelector(

                                    `input[name="Attributes[${index}].Version"]`

                                );


                            if (versionInput) {

                                versionInput.value =

                                    newVersion;

                            }

                        }

                    );

                }


                dirty = false;

                setStatus(

                    "@Html.Raw(L["AutoSaved"].Value)"

                );

            }

            catch (error) {

                console.error(

                    "Profile auto-save failed:",

                    error

                );

                setStatus(

                    "Auto-save failed."

                );

            }

            finally {

                saving = false;

            }

        }


        // Seven seconds is within the required 5-10 second interval.

        setInterval(

            autoSave,

            7000

        );

        // Image attributes are stored as URLs. When Cloudinary's unsigned
        // upload values are configured, files go directly from the browser to
        // Cloudinary; this application never receives or stores the image.
        document.querySelectorAll(".cloud-image-dropzone").forEach(dropzone => {
            const input = document.getElementById(dropzone.dataset.inputId);
            const fileInput = dropzone.querySelector(".cloud-image-file");
            const browse = dropzone.querySelector(".cloud-image-browse");
            const status = dropzone.querySelector(".cloud-image-status");
            const cloudName = dropzone.dataset.cloudName;
            const uploadPreset = dropzone.dataset.uploadPreset;

            const setStatus = (message, isError = false) => {
                status.textContent = message;
                status.className = "small mt-1 cloud-image-status " +
                    (isError ? "text-danger" : "text-muted");
            };

            const upload = async file => {
                if (!file || !file.type.startsWith("image/")) {
                    setStatus("Please choose an image file.", true);
                    return;
                }
                if (file.size > 10 * 1024 * 1024) {
                    setStatus("Images must be 10 MB or smaller.", true);
                    return;
                }
                if (!cloudName || !uploadPreset) {
                    setStatus("Cloud upload is not configured. Paste an external image URL instead.", true);
                    return;
                }

                const formData = new FormData();
                formData.append("file", file);
                formData.append("upload_preset", uploadPreset);
                setStatus("Uploading image…");

                try {
                    const response = await fetch(
                        `https://api.cloudinary.com/v1_1/${encodeURIComponent(cloudName)}/image/upload`,
                        { method: "POST", body: formData });
                    const result = await response.json();
                    if (!response.ok || !result.secure_url) {
                        throw new Error(result.error?.message || "Upload failed.");
                    }
                    input.value = result.secure_url;
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                    setStatus("Uploaded. The external image URL is ready to save.");
                } catch (error) {
                    setStatus(error.message || "Upload failed.", true);
                }
            };

            browse.addEventListener("click", () => fileInput.click());
            fileInput.addEventListener("change", () => upload(fileInput.files[0]));
            dropzone.addEventListener("dragover", event => {
                event.preventDefault();
                dropzone.classList.add("border-primary", "bg-body-tertiary");
            });
            dropzone.addEventListener("dragleave", () =>
                dropzone.classList.remove("border-primary", "bg-body-tertiary"));
            dropzone.addEventListener("drop", event => {
                event.preventDefault();
                dropzone.classList.remove("border-primary", "bg-body-tertiary");
                upload(event.dataTransfer.files[0]);
            });
            dropzone.addEventListener("keydown", event => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    fileInput.click();
                }
            });
        });

    })();

</script>
