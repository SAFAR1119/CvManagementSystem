@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="text-center py-5 my-5">
<p class="text-primary fw-semibold text-uppercase mb-2">Application error</p>
<h1 class="display-6">We couldn't complete that request.</h1>
<p class="text-muted">Please try again. If the issue continues, contact an administrator.</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to home</a>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

</section>
