@model ErrorViewModel
@{
    ViewData["Title"] = L["ErrorTitle"].Value;
}

<section class="text-center py-5 my-5">
<p class="text-primary fw-semibold text-uppercase mb-2">@L["ApplicationErrorLabel"]</p>
<h1 class="display-6">@L["RequestFailedHeading"]</h1>
<p class="text-muted">@L["RequestFailedMessage"]</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">@L["ReturnToHome"]</a>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["RequestIdLabel"]</strong> <code>@Model.RequestId</code>
    </p>
}

</section>
