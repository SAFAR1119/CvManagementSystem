@{
    var currentPath =
        Context.Request.Path.ToString();

    var currentQuery =
        Context.Request.QueryString.ToString();

    var returnUrl =
        currentPath + currentQuery;

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    var isCandidate =
        isAuthenticated &&
        User.IsInRole("Candidate");

    var isRecruiter =
        isAuthenticated &&
        User.IsInRole("Recruiter");

    var isAdministrator =
        isAuthenticated &&
        User.IsInRole("Administrator");

    var currentCulture =
        Context.Features
            .Get<IRequestCultureFeature>()?
            .RequestCulture
            .UICulture
            .Name ?? "en-US";

    var currentLanguage =
        currentCulture.StartsWith(
            "bn",
            StringComparison.OrdinalIgnoreCase)
            ? "বাংলা"
            : "English";

    // Theme is persisted the same way the UI culture is: a long-lived,
    // JS-readable cookie. Reading it here lets us render the correct
    // data-bs-theme attribute on the very first response, so there is no
    // flash of the wrong theme and no dependency on client-side storage.
    var currentTheme =
        Context.Request.Cookies[
            CvManagementSystem.Controllers.ThemeController.CookieName]
            is "dark"
            ? "dark"
            : "light";
}

<!DOCTYPE html>
<html lang="@currentCulture" data-bs-theme="@currentTheme">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - @L["AppName"]
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>

<body>

    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg border-bottom shadow-sm">

            <div class="container">

                <!-- Brand -->

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    @L["AppName"]

                </a>

                <!-- Mobile toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navbar content -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- Main navigation -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Home -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                @L["Home"]

                            </a>

                        </li>

                        <!-- Positions -->
                        <!-- Everyone may browse available positions -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Positions"
                               asp-action="Index">

                                @L["Positions"]

                            </a>

                        </li>

                        <!-- Candidate navigation -->

                        @if (isCandidate)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Profile"
                                   asp-action="Index">

                                    @L["MyProfile"]

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Projects"
                                   asp-action="Index">

                                    @L["MyProjects"]

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Cvs"
                                   asp-action="Index">

                                    @L["MyCVs"]

                                </a>

                            </li>
                        }

                        <!-- Recruiter navigation -->

                        @if (isRecruiter)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Attributes"
                                   asp-action="Index">

                                    @L["AttributeLibrary"]

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Cvs"
                                   asp-action="Index">

                                    @L["CandidateCVs"]

                                </a>

                            </li>
                        }

                        <!-- Administrator navigation -->

                        @if (isAdministrator)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Users">

                                    @L["Users"]

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Attributes"
                                   asp-action="Index">

                                    @L["AttributeLibrary"]

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Cvs"
                                   asp-action="Index">

                                    @L["CVs"]

                                </a>

                            </li>
                        }

                    </ul>

                    <!-- Right side -->

                    <div class="d-flex align-items-lg-center
                                flex-column flex-lg-row gap-2">

                        <!-- Global search -->

                        <form asp-controller="Search"
                              asp-action="Index"
                              method="get"
                              class="d-flex"
                              role="search">

                            <input class="form-control form-control-sm me-2"
                                   type="search"
                                   name="q"
                                   value="@Context.Request.Query["q"]"
                                   placeholder="@L["SearchPlaceholder"]"
                                   aria-label="@L["Search"]" />

                            <button class="btn btn-outline-primary btn-sm"
                                    type="submit">

                                @L["Search"]

                            </button>

                        </form>

                        <!-- Language -->

                        <div class="dropdown">

                            <button class="btn btn-outline-secondary btn-sm
                                           dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                @currentLanguage

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Language"
                                       asp-action="Set"
                                       asp-route-culture="en-US"
                                       asp-route-returnUrl="@returnUrl">

                                        English

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Language"
                                       asp-action="Set"
                                       asp-route-culture="bn-BD"
                                       asp-route-returnUrl="@returnUrl">

                                        বাংলা

                                    </a>

                                </li>

                            </ul>

                        </div>

                        <!-- Theme -->

                        <button type="button"
                                id="themeToggle"
                                class="btn btn-outline-secondary btn-sm">

                            <span id="themeToggleText">
                                @L["Dark"]
                            </span>

                        </button>

                        <!-- Authentication -->

                        @if (isAuthenticated)
                        {
                            <div class="dropdown">

                                <button class="btn btn-primary btn-sm
                                               dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    @(User.Identity?.Name ?? "Account")

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    @if (isCandidate)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Profile"
                                               asp-action="Index">

                                                @L["MyProfile"]

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cvs"
                                               asp-action="Index">

                                                @L["MyCVs"]

                                            </a>

                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }

                                    @if (isRecruiter)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Positions"
                                               asp-action="Index">

                                                @L["Positions"]

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Attributes"
                                               asp-action="Index">

                                                @L["AttributeLibrary"]

                                            </a>

                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }

                                    @if (isAdministrator)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Users">

                                                @L["Users"]

                                            </a>

                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }

                                    <!-- Logout -->

                                    <li>

                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Action(
                                                  "Index",
                                                  "Home",
                                                  new { area = "" })"
                                              method="post"
                                              class="px-3">

                                            <button type="submit"
                                                    class="btn btn-link
                                                           dropdown-item
                                                           px-0">

                                                @L["Logout"]

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>
                        }
                        else
                        {
                            <!-- Anonymous user -->

                            <div class="d-flex gap-2">

                                <a class="btn btn-outline-primary btn-sm"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">

                                    @L["Login"]

                                </a>

                                <a class="btn btn-primary btn-sm"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">

                                    @L["Register"]

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main role="main"
          class="pb-4">

        @RenderBody()

    </main>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="border-top py-4 mt-4">

        <div class="container">

            <div class="d-flex flex-column
                        flex-md-row
                        justify-content-between
                        align-items-center
                        gap-2">

                <div class="text-muted small">

                    &copy; @DateTime.UtcNow.Year
                    @L["AppName"]

                </div>

                <div>

                    <a class="text-decoration-none text-muted small"
                       asp-controller="Home"
                       asp-action="Privacy">

                        Privacy

                    </a>

                </div>

            </div>

        </div>

    </footer>

    @{
        var toastSuccess = TempData["SuccessMessage"] as string ??
            TempData["Success"] as string;
        var toastError = TempData["ErrorMessage"] as string ??
            TempData["Error"] as string;
    }

    @if (!string.IsNullOrWhiteSpace(toastSuccess) ||
         !string.IsNullOrWhiteSpace(toastError))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(toastSuccess))
            {
                <div class="toast align-items-center text-bg-success border-0" role="status" data-auto-toast="true">
                    <div class="d-flex"><div class="toast-body">@toastSuccess</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(toastError))
            {
                <div class="toast align-items-center text-bg-danger border-0" role="alert" data-auto-toast="true">
                    <div class="d-flex"><div class="toast-body">@toastError</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
                </div>
            }
        </div>
    }


    <!-- ===================================================== -->
    <!-- SCRIPTS -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>
        document.querySelectorAll('[data-auto-toast="true"]').forEach(
            element => new bootstrap.Toast(element, { delay: 5500 }).show());
    </script>


    <!-- ===================================================== -->
    <!-- THEME -->
    <!-- ===================================================== -->

    <script>
        (() => {

            const button =
                document.getElementById("themeToggle");

            const text =
                document.getElementById("themeToggleText");

            if (!button || !text) {
                return;
            }

            function getTheme() {

                return document.documentElement
                    .getAttribute("data-bs-theme")
                    || "light";
            }

            function updateButton() {

                const theme =
                    getTheme();

                text.textContent =
                    theme === "dark"
                        ? "Light"
                        : "Dark";
            }

            button.addEventListener(
                "click",
                () => {

                    const currentTheme =
                        getTheme();

                    const newTheme =
                        currentTheme === "dark"
                            ? "light"
                            : "dark";

                    document.documentElement
                        .setAttribute(
                            "data-bs-theme",
                            newTheme);

                    // Same cookie ThemeController writes and _Layout
                    // reads server-side, kept in sync here so the
                    // toggle is instant (no round trip) while still
                    // being persisted for the next page load.
                    document.cookie =
                        "cv-theme=" + newTheme +
                        "; path=/; max-age=" +
                        (60 * 60 * 24 * 365) +
                        "; SameSite=Lax";

                    updateButton();

                });

            updateButton();

        })();
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
