@using CvManagementSystem.Models
@using Microsoft.AspNetCore.Identity
@inject IStringLocalizer<CvManagementSystem.Resources.SharedResource> L
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity"
          asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home")"
          method="post"
          class="d-inline">
        <button type="submit" class="btn btn-link nav-link border-0">
            @L["Logout"]
        </button>
    </form>

    <a class="nav-link"
       asp-area="Identity"
       asp-page="/Account/Manage/Index">
        @L["Hello"] @UserManager.GetUserName(User)
    </a>
}
else
{
    <a class="nav-link"
       asp-area="Identity"
       asp-page="/Account/Register">
        @L["Register"]
    </a>

    <a class="nav-link"
       asp-area="Identity"
       asp-page="/Account/Login">
        @L["Login"]
    </a>
}