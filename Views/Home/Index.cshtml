@model CvManagementSystem.ViewModels.HomeViewModel

@{
    ViewData["Title"] = L["Dashboard"];
}

<div class="container py-4">

    <!-- Hero -->

    <div class="mb-5">

        <h1 class="display-5 fw-bold mb-2">
            @L["AppName"]
        </h1>

        <p class="lead text-muted mb-0">
            @L["CVManagementDescription"]
        </p>

    </div>


    <!-- Statistics -->

    <div class="row g-3 mb-5">

        <div class="col-6 col-lg">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        @L["NewCVs24Hours"]
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Statistics.NewCvsLast24Hours
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        @L["TotalPositions"]
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Statistics.TotalPositions
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        @L["TotalCandidates"]
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Statistics.TotalCandidates
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        @L["TotalRecruiters"]
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Statistics.TotalRecruiters
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        @L["TotalSubmittedCVs"]
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Statistics.TotalSubmittedCvs
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Latest Positions -->

    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <div>

            <h2 class="h4 mb-1">
                @L["LatestPositions"]
            </h2>

            <p class="text-muted mb-0">
                @L["RecentlyCreatedOrUpdated"]
            </p>

        </div>

        <a asp-controller="Positions"
           asp-action="Index"
           class="btn btn-outline-primary">

            @L["ViewAll"]

        </a>

    </div>


    <div class="card shadow-sm mb-5">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            @L["Position"]
                        </th>

                        <th>
                            @L["Description"]
                        </th>

                        <th>
                            @L["SubmittedCVs"]
                        </th>

                        <th>
                            @L["Updated"]
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.LatestPositions.Count == 0)
                    {
                        <tr>

                            <td colspan="4"
                                class="text-center text-muted py-4">

                                @L["NoPositionsAvailable"]

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var position in Model.LatestPositions)
                        {
                            <tr>

                                <td>

                                    <a asp-controller="Positions"
                                       asp-action="Details"
                                       asp-route-id="@position.Id"
                                       class="fw-semibold text-decoration-none">

                                        @(position.Title)

                                    </a>

                                </td>

                                <td>

                                    <span class="text-muted">

                                        @(string.IsNullOrWhiteSpace(
                                            position.Description)
                                            ? "—"
                                            : position.Description)

                                    </span>

                                </td>

                                <td>
                                    @position.SubmittedCvCount
                                </td>

                                <td>

                                    @position.UpdatedAt
                                        .ToLocalTime()
                                        .ToString(
                                            "dd MMM yyyy, HH:mm")

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- Most Popular Positions -->

    <div class="mb-3">

        <h2 class="h4 mb-1">
            @L["MostPopularPositions"]
        </h2>

        <p class="text-muted mb-0">
            @L["HighestSubmittedCVs"]
        </p>

    </div>


    <div class="card shadow-sm mb-5">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            @L["Position"]
                        </th>

                        <th>
                            @L["SubmittedCVs"]
                        </th>

                        <th>
                            @L["Updated"]
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.PopularPositions.Count == 0)
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center text-muted py-4">

                                @L["NoSubmittedCVs"]

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var position in Model.PopularPositions)
                        {
                            <tr>

                                <td>

                                    <a asp-controller="Positions"
                                       asp-action="Details"
                                       asp-route-id="@position.Id"
                                       class="fw-semibold text-decoration-none">

                                        @(position.Title)

                                    </a>

                                </td>

                                <td>
                                    @position.SubmittedCvCount
                                </td>

                                <td>

                                    @position.UpdatedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- Technology Tags -->

    <div class="mb-3">

        <h2 class="h4 mb-1">
            @L["TechnologyTags"]
        </h2>

        <p class="text-muted mb-0">
            @L["ExplorePositionsAndCVs"]
        </p>

    </div>


    <div class="card shadow-sm mb-5">

        <div class="card-body">

            @if (Model.TechnologyTags.Count == 0)
            {
                <p class="text-muted mb-0">
                    @L["NoTechnologyTags"]
                </p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.TechnologyTags)
                    {
                        <a href="@tag.Url"
                           class="badge rounded-pill
                                  text-bg-light
                                  border
                                  text-decoration-none
                                  px-3 py-2">

                            @tag.Name

                            <span class="text-muted ms-1">
                                @tag.Count
                            </span>

                        </a>
                    }

                </div>
            }

        </div>

    </div>

</div>