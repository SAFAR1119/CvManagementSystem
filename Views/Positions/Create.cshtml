@model CvManagementSystem.ViewModels.PositionViewModel

@{
    ViewData["Title"] = L["CreatePosition"];
}


<div class="container py-4">

    <div class="mb-4">
        <h1>@L["CreatePosition"]</h1>

        <p class="text-muted mb-0">
            @L["CreatePositionDescription"]
        </p>
    </div>

    <form asp-action="Create"
          method="post"
          id="positionForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        
@if (User.IsInRole("Recruiter"))
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label asp-for="Department"
                   class="form-label">
                @L["Department"]
            </label>

            <input asp-for="Department"
                   class="form-control"
                   placeholder="@L["DepartmentPlaceholder"]" />

            <span asp-validation-for="Department"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Experience"
                   class="form-label">
                @L["ExperienceLabel"]
            </label>

            <select asp-for="Experience"
                    class="form-select">

                <option value="0">@L["Fresher"]</option>
                <option value="1">@L["OneYear"]</option>
                <option value="2">@string.Format(L["YearsFormat"].Value, 2)</option>
                <option value="3">@string.Format(L["YearsFormat"].Value, 3)</option>
                <option value="4">@string.Format(L["YearsFormat"].Value, 4)</option>
                <option value="5">@string.Format(L["YearsFormat"].Value, 5)</option>
                <option value="6">@string.Format(L["YearsFormat"].Value, 6)</option>
                <option value="7">@string.Format(L["YearsFormat"].Value, 7)</option>
                <option value="8">@string.Format(L["YearsFormat"].Value, 8)</option>
                <option value="9">@string.Format(L["YearsFormat"].Value, 9)</option>
                <option value="10">@string.Format(L["YearsFormat"].Value, 10)</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="EmploymentType"
                   class="form-label">
                @L["EmploymentTypeLabel"]
            </label>

            <select asp-for="EmploymentType"
                    class="form-select">

                <option value="1">@L["FullTimeOption"]</option>
                <option value="2">@L["PartTimeOption"]</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="WorkMode"
                   class="form-label">
                @L["WorkModeLabel"]
            </label>

            <select asp-for="WorkMode"
                    class="form-select">

                <option value="1">@L["OnSite"]</option>
                <option value="2">@L["RemoteOption"]</option>
                <option value="3">@L["HybridOption"]</option>

            </select>
        </div>

    </div>
}
else
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label">
                @L["Department"]
            </label>
            <div class="form-control bg-body-secondary">
                @Model.Department
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["ExperienceLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.Experience == ExperienceLevel.Fresher
                    ? L["Fresher"].Value
                    : Model.Experience == ExperienceLevel.OneYear
                        ? L["OneYear"].Value
                        : string.Format(L["YearsFormat"].Value, (int)Model.Experience))
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["EmploymentTypeLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.EmploymentType == EmploymentType.FullTime
                    ? L["FullTimeOption"]
                    : L["PartTimeOption"])
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["WorkModeLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.WorkMode switch
                {
                    WorkMode.OnSite => L["OnSite"],
                    WorkMode.Remote => L["RemoteOption"],
                    WorkMode.Hybrid => L["HybridOption"],
                    _ => L["OnSite"]
                })
            </div>
        </div>

    </div>
}

        <!-- ================================================= -->
        <!-- BASIC INFORMATION -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["BasicInformation"]</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="@L["PositionTitlePlaceholderExample"]" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="@L["ShortDescription"] @L["OfThePosition"]..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="MaxProjects"
                               class="form-label">
                        </label>

                        <input asp-for="MaxProjects"
                               type="number"
                               min="1"
                               max="20"
                               class="form-control" />

                        <span asp-validation-for="MaxProjects"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            @L["MaxProjectsHelp"]
                        </div>

                    </div>

                    <div class="col-md-6 d-flex align-items-center">

                        <div>

                            <div class="form-check">

                                <input asp-for="IsPublic"
                                       class="form-check-input"
                                       id="isPublic" />

                                <label asp-for="IsPublic"
                                       class="form-check-label">
                                </label>

                            </div>

                            <div class="form-text">
                                @L["PublicPositionsHelp"]
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ATTRIBUTES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>@L["CvAttributes"]</strong>

                    <span id="attributeCount"
                          class="badge text-bg-secondary"
                          data-selected-count-format="@L["SelectedCount"]">
                        @string.Format(L["SelectedCount"].Value, 0)
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted">
                    @L["SelectAttributesFromLibrary"]
                </p>

                @if (Model.AvailableAttributes.Count == 0)
                {
                    <div class="alert alert-light border">
                        @L["NoAttributesInLibrary"]
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-3">

                        <div class="col-md-8">
                            <input type="text"
                                   id="attributeSearch"
                                   class="form-control"
                                   placeholder="@L["SearchByAttributePrefix"]" />
                        </div>

                        <div class="col-md-4">
                            <select id="attributeCategoryFilter"
                                    class="form-select">
                                <option value="">@L["AllCategories"]</option>
                                @foreach (var category in Model.AttributeCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle"
                               id="attributeTable">

                            <thead>

                                <tr>

                                    <th style="width:45px;">

                                        <input type="checkbox"
                                               id="selectAllAttributes"
                                               class="form-check-input" />

                                    </th>

                                    <th>
                                        @L["Attribute"]
                                    </th>

                                    <th>
                                        @L["Category"]
                                    </th>

                                    <th>
                                        @L["Type"]
                                    </th>

                                    <th style="width:100px;">
                                        @L["Required"]
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.AvailableAttributes)
                                {
                                    var selected =
                                        Model.SelectedAttributeIds.Contains(
                                            item.Id);

                                    var required =
                                        Model.RequiredAttributeIds.Contains(
                                            item.Id);

                                    <tr data-name="@item.Name.ToLowerInvariant()"
                                        data-category-id="@item.CategoryId">

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input attribute-check"
                                                   name="SelectedAttributeIds"
                                                   value="@item.Id"
                                                   @(selected ? "checked" : "") />

                                        </td>

                                        <td>
                                            <strong>
                                                @(item.Name)
                                            </strong>
                                        </td>

                                        <td>
                                            @(item.Category)
                                        </td>

                                        <td>
                                            <span class="badge text-bg-light">
                                                @(item.DataType)
                                            </span>
                                        </td>

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input required-check"
                                                   name="RequiredAttributeIds"
                                                   value="@item.Id"
                                                   @(required ? "checked" : "") />

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROJECT TAGS -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>@L["ProjectTechnologyTags"]</strong>

                    <span id="tagCount"
                          class="badge text-bg-secondary"
                          data-selected-count-format="@L["SelectedCount"]">
                        @string.Format(L["SelectedCount"].Value, 0)
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted">
                    @L["CandidateProjectsMatchingTags"]
                </p>

                @if (Model.AvailableTechnologyTags.Count == 0)
                {
                    <div class="alert alert-light border">
                        @L["NoTechnologyTagsCreated"]
                    </div>
                }
                else
                {
                    <div class="row g-2">

                        @foreach (var tag in Model.AvailableTechnologyTags)
                        {
                            var selected =
                                Model.SelectedTechnologyTagIds.Contains(
                                    tag.Id);

                            <div class="col-6 col-md-4 col-lg-3">

                                <label class="border rounded p-3 d-flex gap-2 align-items-center h-100">

                                    <input type="checkbox"
                                           class="form-check-input technology-check"
                                           name="SelectedTechnologyTagIds"
                                           value="@tag.Id"
                                           @(selected ? "checked" : "") />

                                    <span>
                                        @(tag.Name)
                                    </span>

                                </label>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ACCESS RULES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["AccessRules"]</strong>
            </div>

            <div class="card-body">

                <div id="restrictedNotice"
                     class="alert alert-light border">

                    @L["PublicPositionsNoAccessRules"]

                </div>

                <div id="accessRulesSection"
                     style="display:none;"
                     data-attribute-label="@L["Attribute"]"
                     data-operator-label="@L["Operator"]"
                     data-value-label="@L["Value"]"
                     data-remove-label="@L["Remove"]"
                     data-select-attribute="@L["SelectAttributeEllipsis"]"
                     data-select-operator="@L["SelectOperatorEllipsis"]"
                     data-filter-value-placeholder="@L["FilterValuePlaceholder"]"
                     data-op-equals="@L["OperatorEquals"]"
                     data-op-not-equals="@L["OperatorNotEquals"]"
                     data-op-contains="@L["OperatorContains"]"
                     data-op-starts-with="@L["OperatorStartsWith"]"
                     data-op-greater-than="@L["OperatorGreaterThan"]"
                     data-op-greater-than-or-equal="@L["OperatorGreaterThanOrEqual"]"
                     data-op-less-than="@L["OperatorLessThan"]"
                     data-op-less-than-or-equal="@L["OperatorLessThanOrEqual"]"
                     data-op-after="@L["OperatorAfter"]"
                     data-op-on-or-after="@L["OperatorOnOrAfter"]"
                     data-op-before="@L["OperatorBefore"]"
                     data-op-on-or-before="@L["OperatorOnOrBefore"]">

                    <p class="text-muted">
                        @L["CandidatesMustSatisfyRules"]
                    </p>

                    <div id="accessRulesContainer"></div>

                    <button type="button"
                            id="addRuleButton"
                            class="btn btn-outline-primary">
                        @L["AddAccessRule"]
                    </button>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ACTIONS -->
        <!-- ================================================= -->

        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                @L["CreatePosition"]
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                @L["Cancel"]
            </a>

        </div>

    </form>

</div>

<script>

    // =========================================================
    // ATTRIBUTE SELECTION
    // =========================================================

    const attributeChecks =
        document.querySelectorAll(".attribute-check");

    const requiredChecks =
        document.querySelectorAll(".required-check");

    const selectAllAttributes =
        document.getElementById("selectAllAttributes");

    const attributeCount =
        document.getElementById("attributeCount");

    function updateAttributeCount()
    {
        const count =
            document.querySelectorAll(
                ".attribute-check:checked"
            ).length;

        attributeCount.textContent =
            attributeCount.dataset.selectedCountFormat.replace("{0}", count);
    }

    selectAllAttributes.addEventListener(
        "change",
        function ()
        {
            attributeChecks.forEach(
                check =>
                {
                    check.checked =
                        this.checked;
                });

            updateAttributeCount();
        });

    attributeChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    const required =
                        document.querySelector(
                            `.required-check[value="${this.value}"]`
                        );

                    if (!this.checked &&
                        required)
                    {
                        required.checked =
                            false;
                    }

                    updateAttributeCount();
                });
        });

    requiredChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    if (this.checked)
                    {
                        const attribute =
                            document.querySelector(
                                `.attribute-check[value="${this.value}"]`
                            );

                        if (attribute)
                        {
                            attribute.checked =
                                true;
                        }
                    }

                    updateAttributeCount();
                });
        });


    // =========================================================
    // ATTRIBUTE SEARCH
    // =========================================================

    const attributeSearch =
        document.getElementById("attributeSearch");

    const attributeCategoryFilter =
        document.getElementById("attributeCategoryFilter");

    function filterAttributeRows()
    {
        const term =
            (attributeSearch?.value || "")
                .trim()
                .toLowerCase();

        const categoryId =
            attributeCategoryFilter?.value || "";

        document
            .querySelectorAll(
                "#attributeTable tbody tr"
            )
            .forEach(
                row =>
                {
                    const matchesName =
                        !term ||
                        (row.dataset.name || "")
                            .startsWith(term);

                    const matchesCategory =
                        !categoryId ||
                        row.dataset.categoryId === categoryId;

                    row.style.display =
                        matchesName && matchesCategory
                            ? ""
                            : "none";
                });
    }

    if (attributeSearch)
    {
        attributeSearch.addEventListener(
            "input",
            filterAttributeRows);
    }

    if (attributeCategoryFilter)
    {
        attributeCategoryFilter.addEventListener(
            "change",
            filterAttributeRows);
    }


    // =========================================================
    // TECHNOLOGY TAG COUNT
    // =========================================================

    const technologyChecks =
        document.querySelectorAll(
            ".technology-check");

    const tagCount =
        document.getElementById("tagCount");

    function updateTagCount()
    {
        const count =
            document.querySelectorAll(
                ".technology-check:checked"
            ).length;

        tagCount.textContent =
            tagCount.dataset.selectedCountFormat.replace("{0}", count);
    }

    technologyChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                updateTagCount);
        });


    // =========================================================
    // ACCESS RULES
    // =========================================================

    const isPublic =
        document.getElementById("isPublic");

    const accessRulesSection =
        document.getElementById(
            "accessRulesSection");

    const restrictedNotice =
        document.getElementById(
            "restrictedNotice");

    const accessRulesContainer =
        document.getElementById(
            "accessRulesContainer");

    const addRuleButton =
        document.getElementById(
            "addRuleButton");


    const attributes =
    [
        @foreach (var item in Model.AvailableAttributes)
        {
            <text>
            {
                id: @item.Id,
                name: "@Html.Raw(
                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name)
                )",
                type: "@item.DataType"
            },
            </text>
        }
    ];


    const opText =
        accessRulesSection.dataset;

    const operators =
    {
        String:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains],
            ["StartsWith", opText.opStartsWith]
        ],

        Text:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains]
        ],

        Numeric:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["GreaterThan", opText.opGreaterThan],
            ["GreaterThanOrEqual", opText.opGreaterThanOrEqual],
            ["LessThan", opText.opLessThan],
            ["LessThanOrEqual", opText.opLessThanOrEqual]
        ],

        Date:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["GreaterThan", opText.opAfter],
            ["GreaterThanOrEqual", opText.opOnOrAfter],
            ["LessThan", opText.opBefore],
            ["LessThanOrEqual", opText.opOnOrBefore]
        ],

        Boolean:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ],

        Dropdown:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains]
        ],

        Image:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ],

        Period:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ]
    };


    function updateAccessVisibility()
    {
        if (isPublic.checked)
        {
            accessRulesSection.style.display =
                "none";

            restrictedNotice.style.display =
                "block";
        }
        else
        {
            accessRulesSection.style.display =
                "block";

            restrictedNotice.style.display =
                "none";
        }
    }


    function createRuleRow(index)
    {
        const wrapper =
            document.createElement("div");

        wrapper.className =
            "border rounded p-3 mb-3 access-rule";


        const attributeColumn =
            document.createElement("div");

        attributeColumn.className =
            "mb-3";


        const attributeLabel =
            document.createElement("label");

        attributeLabel.className =
            "form-label";

        attributeLabel.textContent =
            opText.attributeLabel;


        const attributeSelect =
            document.createElement("select");

        attributeSelect.className =
            "form-select rule-attribute";

        attributeSelect.name =
            `AccessRules[${index}].AttributeDefinitionId`;

        attributeSelect.required =
            true;


        const emptyOption =
            document.createElement("option");

        emptyOption.value =
            "";

        emptyOption.textContent =
            opText.selectAttribute;

        attributeSelect.appendChild(
            emptyOption);


        attributes.forEach(
            attribute =>
            {
                const option =
                    document.createElement(
                        "option");

                option.value =
                    attribute.id;

                option.textContent =
                    `${attribute.name} (${attribute.type})`;

                option.dataset.type =
                    attribute.type;

                attributeSelect.appendChild(
                    option);
            });


        attributeColumn.appendChild(
            attributeLabel);

        attributeColumn.appendChild(
            attributeSelect);


        const row =
            document.createElement("div");

        row.className =
            "row g-3";


        const operatorColumn =
            document.createElement("div");

        operatorColumn.className =
            "col-md-4";


        const operatorLabel =
            document.createElement("label");

        operatorLabel.className =
            "form-label";

        operatorLabel.textContent =
            opText.operatorLabel;


        const operatorSelect =
            document.createElement("select");

        operatorSelect.className =
            "form-select rule-operator";

        operatorSelect.name =
            `AccessRules[${index}].Operator`;

        operatorSelect.required =
            true;


        const emptyOperator =
            document.createElement("option");

        emptyOperator.value =
            "";

        emptyOperator.textContent =
            opText.selectOperator;

        operatorSelect.appendChild(
            emptyOperator);


        operatorColumn.appendChild(
            operatorLabel);

        operatorColumn.appendChild(
            operatorSelect);


        const valueColumn =
            document.createElement("div");

        valueColumn.className =
            "col-md-6";


        const valueLabel =
            document.createElement("label");

        valueLabel.className =
            "form-label";

        valueLabel.textContent =
            opText.valueLabel;


        const valueInput =
            document.createElement("input");

        valueInput.type =
            "text";

        valueInput.className =
            "form-control rule-value";

        valueInput.name =
            `AccessRules[${index}].Value`;

        valueInput.required =
            true;

        valueInput.placeholder =
            opText.filterValuePlaceholder;


        valueColumn.appendChild(
            valueLabel);

        valueColumn.appendChild(
            valueInput);


        const removeColumn =
            document.createElement("div");

        removeColumn.className =
            "col-md-2 d-flex align-items-end";


        const removeButton =
            document.createElement("button");

        removeButton.type =
            "button";

        removeButton.className =
            "btn btn-outline-danger w-100";

        removeButton.textContent =
            opText.removeLabel;


        removeButton.addEventListener(
            "click",
            function ()
            {
                wrapper.remove();
                renumberRules();
            });


        removeColumn.appendChild(
            removeButton);


        row.appendChild(
            operatorColumn);

        row.appendChild(
            valueColumn);

        row.appendChild(
            removeColumn);


        wrapper.appendChild(
            attributeColumn);

        wrapper.appendChild(
            row);


        function refreshOperators()
        {
            const selected =
                attributeSelect
                    .selectedOptions[0];

            const type =
                selected
                    ? selected.dataset.type
                    : null;

            operatorSelect.innerHTML =
                "";

            const empty =
                document.createElement(
                    "option");

            empty.value =
                "";

            empty.textContent =
                opText.selectOperator;

            operatorSelect.appendChild(
                empty);

            if (!type ||
                !operators[type])
            {
                return;
            }

            operators[type].forEach(
                operator =>
                {
                    const option =
                        document.createElement(
                            "option");

                    option.value =
                        operator[0];

                    option.textContent =
                        operator[1];

                    operatorSelect.appendChild(
                        option);
                });
        }


        attributeSelect.addEventListener(
            "change",
            refreshOperators);


        return wrapper;
    }


    function renumberRules()
    {
        document
            .querySelectorAll(
                ".access-rule")
            .forEach(
                (rule, index) =>
                {
                    const attribute =
                        rule.querySelector(
                            ".rule-attribute");

                    const operator =
                        rule.querySelector(
                            ".rule-operator");

                    const value =
                        rule.querySelector(
                            ".rule-value");

                    attribute.name =
                        `AccessRules[${index}].AttributeDefinitionId`;

                    operator.name =
                        `AccessRules[${index}].Operator`;

                    value.name =
                        `AccessRules[${index}].Value`;
                });
    }


    isPublic.addEventListener(
        "change",
        updateAccessVisibility);


    addRuleButton.addEventListener(
        "click",
        function ()
        {
            const index =
                document.querySelectorAll(
                    ".access-rule"
                ).length;

            accessRulesContainer.appendChild(
                createRuleRow(index));
        });


    updateAccessVisibility();
    updateAttributeCount();
    updateTagCount();

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}