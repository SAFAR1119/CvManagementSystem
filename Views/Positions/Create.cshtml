@model CvManagementSystem.ViewModels.PositionViewModel

@{
    ViewData["Title"] = L["CreatePosition"];
}


<div class="container py-4">

    <div class="mb-4">
        <h1>@L["CreatePosition"]</h1>

        <p class="text-muted mb-0">
            @L["CreatePositionDescription"]
        </p>
    </div>

    <form asp-action="Create"
          method="post"
          id="positionForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        
@if (User.IsInRole("Recruiter"))
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label asp-for="Department"
                   class="form-label">
                Department
            </label>

            <input asp-for="Department"
                   class="form-control"
                   placeholder="e.g. Engineering, HR, Marketing" />

            <span asp-validation-for="Department"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Experience"
                   class="form-label">
                Experience
            </label>

            <select asp-for="Experience"
                    class="form-select">

                <option value="0">Fresher</option>
                <option value="1">1 Year</option>
                <option value="2">2 Years</option>
                <option value="3">3 Years</option>
                <option value="4">4 Years</option>
                <option value="5">5 Years</option>
                <option value="6">6 Years</option>
                <option value="7">7 Years</option>
                <option value="8">8 Years</option>
                <option value="9">9 Years</option>
                <option value="10">10 Years</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="EmploymentType"
                   class="form-label">
                Employment Type
            </label>

            <select asp-for="EmploymentType"
                    class="form-select">

                <option value="1">Full Time</option>
                <option value="2">Part Time</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="WorkMode"
                   class="form-label">
                Work Mode
            </label>

            <select asp-for="WorkMode"
                    class="form-select">

                <option value="1">On-site</option>
                <option value="2">Remote</option>
                <option value="3">Hybrid</option>

            </select>
        </div>

    </div>
}
else
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label">
                Department
            </label>
            <div class="form-control bg-body-secondary">
                @Model.Department
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Experience
            </label>
            <div class="form-control bg-body-secondary">
                @Model.Experience switch
                {
                    ExperienceLevel.Fresher => "Fresher",
                    ExperienceLevel.OneYear => "1 Year",
                    ExperienceLevel.TwoYears => "2 Years",
                    ExperienceLevel.ThreeYears => "3 Years",
                    ExperienceLevel.FourYears => "4 Years",
                    ExperienceLevel.FiveYears => "5 Years",
                    ExperienceLevel.SixYears => "6 Years",
                    ExperienceLevel.SevenYears => "7 Years",
                    ExperienceLevel.EightYears => "8 Years",
                    ExperienceLevel.NineYears => "9 Years",
                    ExperienceLevel.TenYears => "10 Years",
                    _ => "Fresher"
                }
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Employment Type
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.EmploymentType == EmploymentType.FullTime
                    ? "Full Time"
                    : "Part Time")
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                Work Mode
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.WorkMode switch
                {
                    WorkMode.OnSite => "On-site",
                    WorkMode.Remote => "Remote",
                    WorkMode.Hybrid => "Hybrid",
                    _ => "On-site"
                })
            </div>
        </div>

    </div>
}

        <!-- ================================================= -->
        <!-- BASIC INFORMATION -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["BasicInformation"]</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Example: Backend Developer" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="@L["ShortDescription"] @L["OfThePosition"]..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="MaxProjects"
                               class="form-label">
                        </label>

                        <input asp-for="MaxProjects"
                               type="number"
                               min="1"
                               max="20"
                               class="form-control" />

                        <span asp-validation-for="MaxProjects"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Maximum relevant projects included in generated CVs.
                        </div>

                    </div>

                    <div class="col-md-6 d-flex align-items-center">

                        <div>

                            <div class="form-check">

                                <input asp-for="IsPublic"
                                       class="form-check-input"
                                       id="isPublic" />

                                <label asp-for="IsPublic"
                                       class="form-check-label">
                                </label>

                            </div>

                            <div class="form-text">
                                Public positions are available to all authenticated
                                candidates. Restricted positions use access rules.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ATTRIBUTES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>CV Attributes</strong>

                    <span id="attributeCount"
                          class="badge text-bg-secondary">
                        0 selected
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted">
                    Select reusable attributes from the shared Attribute Library.
                    Required attributes must be completed before a candidate can
                    publish the CV.
                </p>

                @if (Model.AvailableAttributes.Count == 0)
                {
                    <div class="alert alert-light border">
                        No attributes exist in the Attribute Library yet.
                    </div>
                }
                else
                {
                    <div class="mb-3">

                        <input type="text"
                               id="attributeSearch"
                               class="form-control"
                               placeholder="Filter attributes..." />

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle"
                               id="attributeTable">

                            <thead>

                                <tr>

                                    <th style="width:45px;">

                                        <input type="checkbox"
                                               id="selectAllAttributes"
                                               class="form-check-input" />

                                    </th>

                                    <th>
                                        Attribute
                                    </th>

                                    <th>
                                        Category
                                    </th>

                                    <th>
                                        Type
                                    </th>

                                    <th style="width:100px;">
                                        Required
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.AvailableAttributes)
                                {
                                    var selected =
                                        Model.SelectedAttributeIds.Contains(
                                            item.Id);

                                    var required =
                                        Model.RequiredAttributeIds.Contains(
                                            item.Id);

                                    <tr data-search="@($"{item.Name} {item.Category} {item.DataType}")">

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input attribute-check"
                                                   name="SelectedAttributeIds"
                                                   value="@item.Id"
                                                   @(selected ? "checked" : "") />

                                        </td>

                                        <td>
                                            <strong>
                                                @(item.Name)
                                            </strong>
                                        </td>

                                        <td>
                                            @(item.Category)
                                        </td>

                                        <td>
                                            <span class="badge text-bg-light">
                                                @(item.DataType)
                                            </span>
                                        </td>

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input required-check"
                                                   name="RequiredAttributeIds"
                                                   value="@item.Id"
                                                   @(required ? "checked" : "") />

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROJECT TAGS -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>Project Technology Tags</strong>

                    <span id="tagCount"
                          class="badge text-bg-secondary">
                        0 selected
                    </span>

                </div>

            </div>

            <div class="card-body">

                <p class="text-muted">
                    Candidate projects matching these tags can be considered
                    when generating the CV.
                </p>

                @if (Model.AvailableTechnologyTags.Count == 0)
                {
                    <div class="alert alert-light border">
                        No technology tags have been created yet.
                    </div>
                }
                else
                {
                    <div class="row g-2">

                        @foreach (var tag in Model.AvailableTechnologyTags)
                        {
                            var selected =
                                Model.SelectedTechnologyTagIds.Contains(
                                    tag.Id);

                            <div class="col-6 col-md-4 col-lg-3">

                                <label class="border rounded p-3 d-flex gap-2 align-items-center h-100">

                                    <input type="checkbox"
                                           class="form-check-input technology-check"
                                           name="SelectedTechnologyTagIds"
                                           value="@tag.Id"
                                           @(selected ? "checked" : "") />

                                    <span>
                                        @(tag.Name)
                                    </span>

                                </label>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ACCESS RULES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Access Rules</strong>
            </div>

            <div class="card-body">

                <div id="restrictedNotice"
                     class="alert alert-light border">

                    Public positions do not require access rules.
                    Select Restricted above to configure candidate filters.

                </div>

                <div id="accessRulesSection"
                     style="display:none;">

                    <p class="text-muted">
                        Candidates must satisfy these rules to create a CV
                        for this position.
                    </p>

                    <div id="accessRulesContainer"></div>

                    <button type="button"
                            id="addRuleButton"
                            class="btn btn-outline-primary">
                        Add Access Rule
                    </button>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- ACTIONS -->
        <!-- ================================================= -->

        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                Create Position
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

<script>

    // =========================================================
    // ATTRIBUTE SELECTION
    // =========================================================

    const attributeChecks =
        document.querySelectorAll(".attribute-check");

    const requiredChecks =
        document.querySelectorAll(".required-check");

    const selectAllAttributes =
        document.getElementById("selectAllAttributes");

    const attributeCount =
        document.getElementById("attributeCount");

    function updateAttributeCount()
    {
        const count =
            document.querySelectorAll(
                ".attribute-check:checked"
            ).length;

        attributeCount.textContent =
            count + " selected";
    }

    selectAllAttributes.addEventListener(
        "change",
        function ()
        {
            attributeChecks.forEach(
                check =>
                {
                    check.checked =
                        this.checked;
                });

            updateAttributeCount();
        });

    attributeChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    const required =
                        document.querySelector(
                            `.required-check[value="${this.value}"]`
                        );

                    if (!this.checked &&
                        required)
                    {
                        required.checked =
                            false;
                    }

                    updateAttributeCount();
                });
        });

    requiredChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    if (this.checked)
                    {
                        const attribute =
                            document.querySelector(
                                `.attribute-check[value="${this.value}"]`
                            );

                        if (attribute)
                        {
                            attribute.checked =
                                true;
                        }
                    }

                    updateAttributeCount();
                });
        });


    // =========================================================
    // ATTRIBUTE SEARCH
    // =========================================================

    const attributeSearch =
        document.getElementById("attributeSearch");

    if (attributeSearch)
    {
        attributeSearch.addEventListener(
            "input",
            function ()
            {
                const term =
                    this.value
                        .trim()
                        .toLowerCase();

                document
                    .querySelectorAll(
                        "#attributeTable tbody tr"
                    )
                    .forEach(
                        row =>
                        {
                            const text =
                                row.dataset.search
                                    .toLowerCase();

                            row.style.display =
                                text.includes(term)
                                    ? ""
                                    : "none";
                        });
            });
    }


    // =========================================================
    // TECHNOLOGY TAG COUNT
    // =========================================================

    const technologyChecks =
        document.querySelectorAll(
            ".technology-check");

    const tagCount =
        document.getElementById("tagCount");

    function updateTagCount()
    {
        tagCount.textContent =
            document.querySelectorAll(
                ".technology-check:checked"
            ).length + " selected";
    }

    technologyChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                updateTagCount);
        });


    // =========================================================
    // ACCESS RULES
    // =========================================================

    const isPublic =
        document.getElementById("isPublic");

    const accessRulesSection =
        document.getElementById(
            "accessRulesSection");

    const restrictedNotice =
        document.getElementById(
            "restrictedNotice");

    const accessRulesContainer =
        document.getElementById(
            "accessRulesContainer");

    const addRuleButton =
        document.getElementById(
            "addRuleButton");


    const attributes =
    [
        @foreach (var item in Model.AvailableAttributes)
        {
            <text>
            {
                id: @item.Id,
                name: "@Html.Raw(
                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name)
                )",
                type: "@item.DataType"
            },
            </text>
        }
    ];


    const operators =
    {
        String:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"],
            ["Contains", "Contains"],
            ["StartsWith", "Starts with"]
        ],

        Text:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"],
            ["Contains", "Contains"]
        ],

        Numeric:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"],
            ["GreaterThan", "Greater than"],
            ["GreaterThanOrEqual", "Greater than or equal"],
            ["LessThan", "Less than"],
            ["LessThanOrEqual", "Less than or equal"]
        ],

        Date:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"],
            ["GreaterThan", "After"],
            ["GreaterThanOrEqual", "On or after"],
            ["LessThan", "Before"],
            ["LessThanOrEqual", "On or before"]
        ],

        Boolean:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"]
        ],

        Dropdown:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"],
            ["Contains", "Contains"]
        ],

        Image:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"]
        ],

        Period:
        [
            ["Equals", "Equals"],
            ["NotEquals", "Not equals"]
        ]
    };


    function updateAccessVisibility()
    {
        if (isPublic.checked)
        {
            accessRulesSection.style.display =
                "none";

            restrictedNotice.style.display =
                "block";
        }
        else
        {
            accessRulesSection.style.display =
                "block";

            restrictedNotice.style.display =
                "none";
        }
    }


    function createRuleRow(index)
    {
        const wrapper =
            document.createElement("div");

        wrapper.className =
            "border rounded p-3 mb-3 access-rule";


        const attributeColumn =
            document.createElement("div");

        attributeColumn.className =
            "mb-3";


        const attributeLabel =
            document.createElement("label");

        attributeLabel.className =
            "form-label";

        attributeLabel.textContent =
            "Attribute";


        const attributeSelect =
            document.createElement("select");

        attributeSelect.className =
            "form-select rule-attribute";

        attributeSelect.name =
            `AccessRules[${index}].AttributeDefinitionId`;

        attributeSelect.required =
            true;


        const emptyOption =
            document.createElement("option");

        emptyOption.value =
            "";

        emptyOption.textContent =
            "Select attribute...";

        attributeSelect.appendChild(
            emptyOption);


        attributes.forEach(
            attribute =>
            {
                const option =
                    document.createElement(
                        "option");

                option.value =
                    attribute.id;

                option.textContent =
                    `${attribute.name} (${attribute.type})`;

                option.dataset.type =
                    attribute.type;

                attributeSelect.appendChild(
                    option);
            });


        attributeColumn.appendChild(
            attributeLabel);

        attributeColumn.appendChild(
            attributeSelect);


        const row =
            document.createElement("div");

        row.className =
            "row g-3";


        const operatorColumn =
            document.createElement("div");

        operatorColumn.className =
            "col-md-4";


        const operatorLabel =
            document.createElement("label");

        operatorLabel.className =
            "form-label";

        operatorLabel.textContent =
            "Operator";


        const operatorSelect =
            document.createElement("select");

        operatorSelect.className =
            "form-select rule-operator";

        operatorSelect.name =
            `AccessRules[${index}].Operator`;

        operatorSelect.required =
            true;


        const emptyOperator =
            document.createElement("option");

        emptyOperator.value =
            "";

        emptyOperator.textContent =
            "Select operator...";

        operatorSelect.appendChild(
            emptyOperator);


        operatorColumn.appendChild(
            operatorLabel);

        operatorColumn.appendChild(
            operatorSelect);


        const valueColumn =
            document.createElement("div");

        valueColumn.className =
            "col-md-6";


        const valueLabel =
            document.createElement("label");

        valueLabel.className =
            "form-label";

        valueLabel.textContent =
            "Value";


        const valueInput =
            document.createElement("input");

        valueInput.type =
            "text";

        valueInput.className =
            "form-control rule-value";

        valueInput.name =
            `AccessRules[${index}].Value`;

        valueInput.required =
            true;

        valueInput.placeholder =
            "Filter value...";


        valueColumn.appendChild(
            valueLabel);

        valueColumn.appendChild(
            valueInput);


        const removeColumn =
            document.createElement("div");

        removeColumn.className =
            "col-md-2 d-flex align-items-end";


        const removeButton =
            document.createElement("button");

        removeButton.type =
            "button";

        removeButton.className =
            "btn btn-outline-danger w-100";

        removeButton.textContent =
            "Remove";


        removeButton.addEventListener(
            "click",
            function ()
            {
                wrapper.remove();
                renumberRules();
            });


        removeColumn.appendChild(
            removeButton);


        row.appendChild(
            operatorColumn);

        row.appendChild(
            valueColumn);

        row.appendChild(
            removeColumn);


        wrapper.appendChild(
            attributeColumn);

        wrapper.appendChild(
            row);


        function refreshOperators()
        {
            const selected =
                attributeSelect
                    .selectedOptions[0];

            const type =
                selected
                    ? selected.dataset.type
                    : null;

            operatorSelect.innerHTML =
                "";

            const empty =
                document.createElement(
                    "option");

            empty.value =
                "";

            empty.textContent =
                "Select operator...";

            operatorSelect.appendChild(
                empty);

            if (!type ||
                !operators[type])
            {
                return;
            }

            operators[type].forEach(
                operator =>
                {
                    const option =
                        document.createElement(
                            "option");

                    option.value =
                        operator[0];

                    option.textContent =
                        operator[1];

                    operatorSelect.appendChild(
                        option);
                });
        }


        attributeSelect.addEventListener(
            "change",
            refreshOperators);


        return wrapper;
    }


    function renumberRules()
    {
        document
            .querySelectorAll(
                ".access-rule")
            .forEach(
                (rule, index) =>
                {
                    const attribute =
                        rule.querySelector(
                            ".rule-attribute");

                    const operator =
                        rule.querySelector(
                            ".rule-operator");

                    const value =
                        rule.querySelector(
                            ".rule-value");

                    attribute.name =
                        `AccessRules[${index}].AttributeDefinitionId`;

                    operator.name =
                        `AccessRules[${index}].Operator`;

                    value.name =
                        `AccessRules[${index}].Value`;
                });
    }


    isPublic.addEventListener(
        "change",
        updateAccessVisibility);


    addRuleButton.addEventListener(
        "click",
        function ()
        {
            const index =
                document.querySelectorAll(
                    ".access-rule"
                ).length;

            accessRulesContainer.appendChild(
                createRuleRow(index));
        });


    updateAccessVisibility();
    updateAttributeCount();
    updateTagCount();

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}