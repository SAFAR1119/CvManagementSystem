@model CvManagementSystem.ViewModels.PositionViewModel

@{
    ViewData["Title"] = L["EditPosition"];
}


@if (User.IsInRole("Recruiter"))
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label asp-for="Department"
                   class="form-label">
                @L["Department"]
            </label>

            <input asp-for="Department"
                   class="form-control"
                   placeholder="@L["DepartmentPlaceholder"]" />

            <span asp-validation-for="Department"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Experience"
                   class="form-label">
                @L["ExperienceLabel"]
            </label>

            <select asp-for="Experience"
                    class="form-select">

                <option value="0">@L["Fresher"]</option>
                <option value="1">@L["OneYear"]</option>
                <option value="2">@string.Format(L["YearsFormat"].Value, 2)</option>
                <option value="3">@string.Format(L["YearsFormat"].Value, 3)</option>
                <option value="4">@string.Format(L["YearsFormat"].Value, 4)</option>
                <option value="5">@string.Format(L["YearsFormat"].Value, 5)</option>
                <option value="6">@string.Format(L["YearsFormat"].Value, 6)</option>
                <option value="7">@string.Format(L["YearsFormat"].Value, 7)</option>
                <option value="8">@string.Format(L["YearsFormat"].Value, 8)</option>
                <option value="9">@string.Format(L["YearsFormat"].Value, 9)</option>
                <option value="10">@string.Format(L["YearsFormat"].Value, 10)</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="EmploymentType"
                   class="form-label">
                @L["EmploymentTypeLabel"]
            </label>

            <select asp-for="EmploymentType"
                    class="form-select">

                <option value="1">@L["FullTimeOption"]</option>
                <option value="2">@L["PartTimeOption"]</option>

            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="WorkMode"
                   class="form-label">
                @L["WorkModeLabel"]
            </label>

            <select asp-for="WorkMode"
                    class="form-select">

                <option value="1">@L["OnSite"]</option>
                <option value="2">@L["RemoteOption"]</option>
                <option value="3">@L["HybridOption"]</option>

            </select>
        </div>

    </div>
}
else
{
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label">
                @L["Department"]
            </label>
            <div class="form-control bg-body-secondary">
                @Model.Department
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["ExperienceLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.Experience == ExperienceLevel.Fresher
                    ? L["Fresher"].Value
                    : Model.Experience == ExperienceLevel.OneYear
                        ? L["OneYear"].Value
                        : string.Format(L["YearsFormat"].Value, (int)Model.Experience))
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["EmploymentTypeLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.EmploymentType == EmploymentType.FullTime
                    ? L["FullTimeOption"]
                    : L["PartTimeOption"])
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                @L["WorkModeLabel"]
            </label>
            <div class="form-control bg-body-secondary">
                @(Model.WorkMode switch
                {
                    WorkMode.OnSite => L["OnSite"],
                    WorkMode.Remote => L["RemoteOption"],
                    WorkMode.Hybrid => L["HybridOption"],
                    _ => L["OnSite"]
                })
            </div>
        </div>

    </div>
}

<div class="container py-4">

    <div class="mb-4">
        <h1>@L["EditPosition"]</h1>

        <p class="text-muted mb-0">
            @L["UpdatePositionDescription"]
        </p>
    </div>

    <form asp-action="Edit"
          method="post"
          id="positionForm">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="Version"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- BASIC INFORMATION -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["BasicInformation"]</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="MaxProjects"
                               class="form-label">
                        </label>

                        <input asp-for="MaxProjects"
                               type="number"
                               min="1"
                               max="20"
                               class="form-control" />

                        <span asp-validation-for="MaxProjects"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 d-flex align-items-center">

                        <div>

                            <div class="form-check">

                                <input asp-for="IsPublic"
                                       class="form-check-input"
                                       id="isPublic" />

                                <label asp-for="IsPublic"
                                       class="form-check-label">
                                </label>

                            </div>

                            <div class="form-text">
                                @L["PublicPositionsHelp"]
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ATTRIBUTES -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>
                        @L["CvAttributes"]
                    </strong>

                    <span id="attributeCount"
                          class="badge text-bg-secondary"
                          data-selected-count-format="@L["SelectedCount"]">
                        @string.Format(L["SelectedCount"].Value, 0)
                    </span>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-2 mb-3">

                    <div class="col-md-8">
                        <input type="text"
                               id="attributeSearch"
                               class="form-control"
                               placeholder="@L["SearchByAttributePrefix"]" />
                    </div>

                    <div class="col-md-4">
                        <select id="attributeCategoryFilter"
                                class="form-select">
                            <option value="">@L["AllCategories"]</option>
                            @foreach (var category in Model.AttributeCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle"
                           id="attributeTable">

                        <thead>

                            <tr>

                                <th style="width:45px;">

                                    <input type="checkbox"
                                           id="selectAllAttributes"
                                           class="form-check-input" />

                                </th>

                                <th>
                                    @L["Attribute"]
                                </th>

                                <th>
                                    @L["Category"]
                                </th>

                                <th>
                                    @L["Type"]
                                </th>

                                <th>
                                    @L["Required"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.AvailableAttributes)
                            {
                                var selected =
                                    Model.SelectedAttributeIds.Contains(
                                        item.Id);

                                var required =
                                    Model.RequiredAttributeIds.Contains(
                                        item.Id);

                                <tr data-name="@item.Name.ToLowerInvariant()"
                                    data-category-id="@item.CategoryId">

                                    <td>

                                        <input type="checkbox"
                                               class="form-check-input attribute-check"
                                               name="SelectedAttributeIds"
                                               value="@item.Id"
                                               @(selected ? "checked" : "") />

                                    </td>

                                    <td>
                                        <strong>
                                            @(item.Name)
                                        </strong>
                                    </td>

                                    <td>
                                        @(item.Category)
                                    </td>

                                    <td>
                                        <span class="badge text-bg-light">
                                            @(item.DataType)
                                        </span>
                                    </td>

                                    <td>

                                        <input type="checkbox"
                                               class="form-check-input required-check"
                                               name="RequiredAttributeIds"
                                               value="@item.Id"
                                               @(required ? "checked" : "") />

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- TECHNOLOGY TAGS -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <strong>
                        @L["ProjectTechnologyTags"]
                    </strong>

                    <span id="tagCount"
                          class="badge text-bg-secondary"
                          data-selected-count-format="@L["SelectedCount"]">
                        @string.Format(L["SelectedCount"].Value, 0)
                    </span>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-2">

                    @foreach (var tag in Model.AvailableTechnologyTags)
                    {
                        var selected =
                            Model.SelectedTechnologyTagIds.Contains(
                                tag.Id);

                        <div class="col-6 col-md-4 col-lg-3">

                            <label class="border rounded p-3 d-flex gap-2 align-items-center h-100">

                                <input type="checkbox"
                                       class="form-check-input technology-check"
                                       name="SelectedTechnologyTagIds"
                                       value="@tag.Id"
                                       @(selected ? "checked" : "") />

                                <span>
                                    @(tag.Name)
                                </span>

                            </label>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ACCESS RULES -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["AccessRules"]</strong>
            </div>

            <div class="card-body">

                <div id="restrictedNotice"
                     class="alert alert-light border">
                    @L["PublicPositionsNoAccessRules"]
                </div>

                <div id="accessRulesSection"
                     data-attribute-label="@L["Attribute"]"
                     data-operator-label="@L["Operator"]"
                     data-value-label="@L["Value"]"
                     data-remove-label="@L["Remove"]"
                     data-select-attribute="@L["SelectAttributeEllipsis"]"
                     data-select-operator="@L["SelectOperatorEllipsis"]"
                     data-filter-value-placeholder="@L["FilterValuePlaceholder"]"
                     data-op-equals="@L["OperatorEquals"]"
                     data-op-not-equals="@L["OperatorNotEquals"]"
                     data-op-contains="@L["OperatorContains"]"
                     data-op-starts-with="@L["OperatorStartsWith"]"
                     data-op-greater-than="@L["OperatorGreaterThan"]"
                     data-op-greater-than-or-equal="@L["OperatorGreaterThanOrEqual"]"
                     data-op-less-than="@L["OperatorLessThan"]"
                     data-op-less-than-or-equal="@L["OperatorLessThanOrEqual"]"
                     data-op-after="@L["OperatorAfter"]"
                     data-op-on-or-after="@L["OperatorOnOrAfter"]"
                     data-op-before="@L["OperatorBefore"]"
                     data-op-on-or-before="@L["OperatorOnOrBefore"]">

                    <p class="text-muted">
                        @L["CandidatesMustSatisfyRules"]
                    </p>

                    <div id="accessRulesContainer">

                        @for (var i = 0;
                              i < Model.AccessRules.Count;
                              i++)
                        {
                            var rule =
                                Model.AccessRules[i];

                            <div class="border rounded p-3 mb-3 access-rule">

                                

                                <div class="row g-3">

                                    <div class="col-md-4">

                                        <label class="form-label">
                                            @L["Attribute"]
                                        </label>

                                        <select class="form-select rule-attribute"
                                                name="AccessRules[@i].AttributeDefinitionId">

                                            @foreach (var availableAttribute in Model.AvailableAttributes)
                                            {
                                                if (availableAttribute.Id ==
                                                    rule.AttributeDefinitionId)
                                                {
                                                    <option value="@availableAttribute.Id"
                                                            selected>
                                                        @(availableAttribute.Name)
                                                        — @(availableAttribute.DataType)
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@availableAttribute.Id">
                                                        @(availableAttribute.Name)
                                                        — @(availableAttribute.DataType)
                                                    </option>
                                                }
                                            }

                                        </select>

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            @L["Operator"]
                                        </label>

                                        <select class="form-select rule-operator"
                                                name="AccessRules[@i].Operator">

                                            <option value="@rule.Operator">
                                                @(rule.Operator)
                                            </option>

                                        </select>

                                    </div>

                                    <div class="col-md-4">

                                        <label class="form-label">
                                            @L["Value"]
                                        </label>

                                        <input type="text"
                                               class="form-control rule-value"
                                               name="AccessRules[@i].Value"
                                               value="@rule.Value"
                                               placeholder="@L["FilterValuePlaceholder"]" />

                                    </div>

                                    <div class="col-md-1 d-flex align-items-end">

                                        <button type="button"
                                                class="btn btn-outline-danger remove-rule w-100">
                                            ×
                                        </button>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <button type="button"
                            id="addRuleButton"
                            class="btn btn-outline-primary">
                        @L["AddAccessRule"]
                    </button>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                @L["SaveChanges"]
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                @L["Cancel"]
            </a>

        </div>

    </form>

</div>

<script>

    // =========================================================
    // ATTRIBUTE SELECTION
    // =========================================================

    const attributeChecks =
        document.querySelectorAll(".attribute-check");

    const requiredChecks =
        document.querySelectorAll(".required-check");

    const selectAllAttributes =
        document.getElementById("selectAllAttributes");

    const attributeCount =
        document.getElementById("attributeCount");

    function updateAttributeCount()
    {
        const count =
            document.querySelectorAll(
                ".attribute-check:checked"
            ).length;

        attributeCount.textContent =
            attributeCount.dataset.selectedCountFormat.replace("{0}", count);
    }

    selectAllAttributes.addEventListener(
        "change",
        function ()
        {
            attributeChecks.forEach(
                check =>
                {
                    check.checked =
                        this.checked;
                });

            updateAttributeCount();
        });

    attributeChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    const required =
                        document.querySelector(
                            `.required-check[value="${this.value}"]`
                        );

                    if (!this.checked &&
                        required)
                    {
                        required.checked =
                            false;
                    }

                    updateAttributeCount();
                });
        });

    requiredChecks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    if (this.checked)
                    {
                        const attribute =
                            document.querySelector(
                                `.attribute-check[value="${this.value}"]`
                            );

                        if (attribute)
                        {
                            attribute.checked =
                                true;
                        }
                    }

                    updateAttributeCount();
                });
        });


    // =========================================================
    // ATTRIBUTE SEARCH
    // =========================================================

    const attributeSearch =
        document.getElementById("attributeSearch");

    const attributeCategoryFilter =
        document.getElementById("attributeCategoryFilter");

    function filterAttributeRows()
    {
        const term =
            (attributeSearch?.value || "")
                .trim()
                .toLowerCase();

        const categoryId =
            attributeCategoryFilter?.value || "";

        document
            .querySelectorAll(
                "#attributeTable tbody tr"
            )
            .forEach(
                row =>
                {
                    const matchesName =
                        !term ||
                        (row.dataset.name || "")
                            .startsWith(term);

                    const matchesCategory =
                        !categoryId ||
                        row.dataset.categoryId === categoryId;

                    row.style.display =
                        matchesName && matchesCategory
                            ? ""
                            : "none";
                });
    }

    if (attributeSearch)
    {
        attributeSearch.addEventListener(
            "input",
            filterAttributeRows);
    }

    if (attributeCategoryFilter)
    {
        attributeCategoryFilter.addEventListener(
            "change",
            filterAttributeRows);
    }


    // =========================================================
    // TAG COUNT
    // =========================================================

    const tagCount =
        document.getElementById("tagCount");

    function updateTagCount()
    {
        const count =
            document.querySelectorAll(
                ".technology-check:checked"
            ).length;

        tagCount.textContent =
            tagCount.dataset.selectedCountFormat.replace("{0}", count);
    }

    document
        .querySelectorAll(
            ".technology-check")
        .forEach(
            check =>
            {
                check.addEventListener(
                    "change",
                    updateTagCount);
            });


    // =========================================================
    // ACCESS RULE VISIBILITY
    // =========================================================

    const isPublic =
        document.getElementById("isPublic");

    const restrictedNotice =
        document.getElementById(
            "restrictedNotice");

    const accessRulesSection =
        document.getElementById(
            "accessRulesSection");

    function updateAccessVisibility()
    {
        if (isPublic.checked)
        {
            restrictedNotice.style.display =
                "block";

            accessRulesSection.style.display =
                "none";
        }
        else
        {
            restrictedNotice.style.display =
                "none";

            accessRulesSection.style.display =
                "block";
        }
    }

    isPublic.addEventListener(
        "change",
        updateAccessVisibility);


    // =========================================================
    // ACCESS RULE OPERATORS
    // =========================================================

    const attributes =
    [
        @foreach (var item in Model.AvailableAttributes)
        {
            <text>
            {
                id: @item.Id,
                name: "@Html.Raw(
                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name)
                )",
                type: "@item.DataType"
            },
            </text>
        }
    ];


    const opText =
        accessRulesSection.dataset;

    const operators =
    {
        String:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains],
            ["StartsWith", opText.opStartsWith]
        ],

        Text:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains]
        ],

        Numeric:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["GreaterThan", opText.opGreaterThan],
            ["GreaterThanOrEqual", opText.opGreaterThanOrEqual],
            ["LessThan", opText.opLessThan],
            ["LessThanOrEqual", opText.opLessThanOrEqual]
        ],

        Date:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["GreaterThan", opText.opAfter],
            ["GreaterThanOrEqual", opText.opOnOrAfter],
            ["LessThan", opText.opBefore],
            ["LessThanOrEqual", opText.opOnOrBefore]
        ],

        Boolean:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ],

        Dropdown:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals],
            ["Contains", opText.opContains]
        ],

        Image:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ],

        Period:
        [
            ["Equals", opText.opEquals],
            ["NotEquals", opText.opNotEquals]
        ]
    };


    function populateOperators(
        attributeSelect,
        operatorSelect)
    {
        const selected =
            attributeSelect.selectedOptions[0];

        const type =
            selected
                ? selected.dataset.type
                : null;

        operatorSelect.innerHTML =
            `<option value="">${opText.selectOperator}</option>`;

        if (!type ||
            !operators[type])
        {
            return;
        }

        operators[type].forEach(
            item =>
            {
                const option =
                    document.createElement(
                        "option");

                option.value =
                    item[0];

                option.textContent =
                    item[1];

                operatorSelect.appendChild(
                    option);
            });
    }


    function setAttributeTypes()
    {
        document
            .querySelectorAll(
                ".rule-attribute"
            )
            .forEach(
                select =>
                {
                    Array.from(
                        select.options
                    ).forEach(
                        option =>
                        {
                            const attribute =
                                attributes.find(
                                    x =>
                                        x.id ==
                                        option.value);

                            if (attribute)
                            {
                                option.dataset.type =
                                    attribute.type;
                            }
                        });
                });
    }


    function renumberRules()
    {
        document
            .querySelectorAll(
                ".access-rule"
            )
            .forEach(
                (rule, index) =>
                {
                    const attribute =
                        rule.querySelector(
                            ".rule-attribute");

                    const operator =
                        rule.querySelector(
                            ".rule-operator");

                    const value =
                        rule.querySelector(
                            ".rule-value");

                    attribute.name =
                        `AccessRules[${index}].AttributeDefinitionId`;

                    operator.name =
                        `AccessRules[${index}].Operator`;

                    value.name =
                        `AccessRules[${index}].Value`;
                });
    }


    function attachRuleEvents(
        rule)
    {
        const attribute =
            rule.querySelector(
                ".rule-attribute");

        const operator =
            rule.querySelector(
                ".rule-operator");

        const remove =
            rule.querySelector(
                ".remove-rule");

        attribute.addEventListener(
            "change",
            function ()
            {
                const currentValue =
                    operator.value;

                populateOperators(
                    attribute,
                    operator);

                const exists =
                    Array.from(
                        operator.options
                    ).some(
                        option =>
                            option.value ===
                            currentValue);

                if (exists)
                {
                    operator.value =
                        currentValue;
                }
            });

        remove.addEventListener(
            "click",
            function ()
            {
                rule.remove();

                renumberRules();
            });
    }


    // Attach events to existing rules.
    document
        .querySelectorAll(
            ".access-rule"
        )
        .forEach(
            rule =>
            {
                setAttributeTypes();

                attachRuleEvents(
                    rule);
            });


    // =========================================================
    // ADD RULE
    // =========================================================

    document
        .getElementById("addRuleButton")
        .addEventListener(
            "click",
            function ()
            {
                const index =
                    document.querySelectorAll(
                        ".access-rule"
                    ).length;

                const wrapper =
                    document.createElement(
                        "div");

                wrapper.className =
                    "border rounded p-3 mb-3 access-rule";

                wrapper.innerHTML =
                    `
                    <div class="row g-3">

                        <div class="col-md-4">

                            <label class="form-label">
                                ${opText.attributeLabel}
                            </label>

                            <select class="form-select rule-attribute"
                                    name="AccessRules[${index}].AttributeDefinitionId">

                                <option value="">
                                    ${opText.selectAttribute}
                                </option>

                                ${attributes
                                    .map(
                                        attribute =>
                                            `<option value="${attribute.id}"
                                                     data-type="${attribute.type}">
                                                ${attribute.name} — ${attribute.type}
                                             </option>`
                                    )
                                    .join("")}

                            </select>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                ${opText.operatorLabel}
                            </label>

                            <select class="form-select rule-operator"
                                    name="AccessRules[${index}].Operator">

                                <option value="">
                                    ${opText.selectOperator}
                                </option>

                            </select>

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                ${opText.valueLabel}
                            </label>

                            <input type="text"
                                   class="form-control rule-value"
                                   name="AccessRules[${index}].Value"
                                   placeholder="${opText.filterValuePlaceholder}"
                                   required />

                        </div>

                        <div class="col-md-1 d-flex align-items-end">

                            <button type="button"
                                    class="btn btn-outline-danger remove-rule w-100">
                                ×
                            </button>

                        </div>

                    </div>
                    `;

                document
                    .getElementById(
                        "accessRulesContainer")
                    .appendChild(wrapper);

                attachRuleEvents(
                    wrapper);
            });


    // =========================================================
    // INITIALIZE
    // =========================================================

    setAttributeTypes();

    document
        .querySelectorAll(
            ".access-rule"
        )
        .forEach(
            rule =>
            {
                const attribute =
                    rule.querySelector(
                        ".rule-attribute");

                const operator =
                    rule.querySelector(
                        ".rule-operator");

                const savedOperator =
                    operator.value;

                populateOperators(
                    attribute,
                    operator);

                operator.value =
                    savedOperator;
            });

    updateAccessVisibility();
    updateAttributeCount();
    updateTagCount();

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}