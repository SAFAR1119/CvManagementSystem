@{
    ViewData["Title"] = "Positions";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">
                Available Positions
            </h1>

            <p class="text-secondary mb-0">
                Browse positions and their CV requirements.
            </p>
        </div>

        <span class="badge text-bg-secondary">
            Coming soon
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Position</th>
                    <th>Description</th>
                    <th>Access</th>
                    <th>Updated</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>
                        <strong>Backend Developer</strong>
                    </td>
                    <td>
                        .NET and backend development
                    </td>
                    <td>
                        <span class="badge text-bg-success">
                            Public
                        </span>
                    </td>
                    <td>
                        Not available yet
                    </td>
                </tr>

                <tr>
                    <td>
                        <strong>Business Analyst</strong>
                    </td>
                    <td>
                        Business analysis and communication
                    </td>
                    <td>
                        <span class="badge text-bg-success">
                            Public
                        </span>
                    </td>
                    <td>
                        Not available yet
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="alert alert-info mt-4">
        Position management will be connected to the database
        in the next development phase.
    </div>

</div>