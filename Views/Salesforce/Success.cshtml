@model CvManagementSystem.ViewModels.SalesforceIntegrationResultViewModel

@{
    ViewData["Title"] = "Salesforce Integration Complete";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="display-5 mb-3">
                            ✓
                        </div>

                        <h1 class="h3">
                            Salesforce integration completed
                        </h1>

                        <p class="text-muted mb-0">
                            The Account and linked Contact were created successfully.
                        </p>

                    </div>


                    <div class="border rounded p-3 mb-4">

                        <div class="mb-3">

                            <div class="text-muted small">
                                User
                            </div>

                            <div class="fw-semibold">
                                @Model.DisplayName
                            </div>

                        </div>


                        <div class="mb-3">

                            <div class="text-muted small">
                                Salesforce Account ID
                            </div>

                            <div class="font-monospace">
                                @Model.AccountId
                            </div>

                        </div>


                        <div>

                            <div class="text-muted small">
                                Salesforce Contact ID
                            </div>

                            <div class="font-monospace">
                                @Model.ContactId
                            </div>

                        </div>

                    </div>


                    <div class="d-flex flex-column flex-sm-row gap-2">

                        <a href="@Model.AccountUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-primary">

                            Open Salesforce Account

                        </a>

                        <a href="@Model.ContactUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary">

                            Open Salesforce Contact

                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Back to Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>