@model IReadOnlyList<CvManagementSystem.Models.AttributeDefinition>

@{
    ViewData["Title"] = "Attribute Library";

    var categories =
        ViewBag.Categories
        as List<CvManagementSystem.Models.AttributeCategory>
        ?? new List<CvManagementSystem.Models.AttributeCategory>();

    string? search =
        ViewBag.Search as string;

    int? selectedCategoryId =
        ViewBag.CategoryId as int?;
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                @L["AttributeLibrary"]
            </h1>

            <p class="text-muted mb-0">
                @L["ManageAttributesDescription"]
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            @L["CreateAttribute"]
        </a>

    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">
            @error
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <!-- Search and Filter -->

            <form asp-action="Index"
                  method="get"
                  class="row g-2 mb-3">

                <div class="col-md-5">

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="@L["SearchByAttributePrefix"]" />

                </div>

                <div class="col-md-4">

                    <select name="categoryId"
                            class="form-select">

                        <option value="">
                            @L["AllCategories"]
                        </option>

                        @foreach (var category in categories)
                        {
                            if (selectedCategoryId == category.Id)
                            {
                                <option value="@category.Id"
                                        selected>
                                    @category.Name
                                </option>
                            }
                            else
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-outline-primary">
                        @L["Search"]
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @L["Clear"]
                    </a>

                </div>

            </form>

            <!-- Toolbar -->

            <form asp-action="Delete"
                  method="post"
                  id="attributeForm">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center gap-2 mb-3"
                     data-select-one-message="@L["SelectExactlyOneAttribute"]"
                     data-select-min-message="@L["SelectAtLeastOneAttribute"]"
                     data-confirm-delete-message="@L["ConfirmDeleteAttributes"]"
                     data-selected-count-format="@L["SelectedCount"]">

                    <button type="button"
                            class="btn btn-outline-primary"
                            onclick="editSelected()">
                        @L["EditSelected"]
                    </button>

                    <button type="submit"
                            class="btn btn-outline-danger"
                            onclick="return confirmDelete()">
                        @L["DeleteSelected"]
                    </button>

                    <span id="selectedCount"
                          class="text-muted small">
                        @string.Format(L["SelectedCount"].Value, 0)
                    </span>

                </div>

                <!-- Attribute Table -->

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th style="width: 45px;">

                                    <input type="checkbox"
                                           id="selectAll"
                                           class="form-check-input" />

                                </th>

                                <th>
                                    @L["Attribute"]
                                </th>

                                <th>
                                    @L["Category"]
                                </th>

                                <th>
                                    @L["Type"]
                                </th>

                                <th>
                                    @L["LastUsed"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.Count == 0)
                            {
                                <tr>

                                    <td colspan="5"
                                        class="text-center text-muted py-5">

                                        @L["NoAttributesFound"]

                                    </td>

                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <input type="checkbox"
                                                   class="form-check-input row-check"
                                                   name="selectedIds"
                                                   value="@item.Id" />

                                        </td>

                                        <td>

                                            <strong>
                                                @(item.Name)
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <div class="small text-muted">
                                                    @(item.Description)
                                                </div>
                                            }

                                        </td>

                                        <td>
                                            @(item.Category.Name)
                                        </td>

                                        <td>

                                            <span class="badge text-bg-light">
                                                @(item.DataType)
                                            </span>

                                        </td>

                                        <td>

                                            @if (item.LastUsedAt.HasValue)
                                            {
                                                @(item.LastUsedAt.Value
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy"))
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    @L["Never"]
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

    const selectAll =
        document.getElementById("selectAll");

    const rowChecks =
        document.querySelectorAll(".row-check");

    const selectedCount =
        document.getElementById("selectedCount");

    const toolbar =
        document.getElementById("attributeForm")
            .querySelector("[data-selected-count-format]");

    function updateSelectedCount() {

        const count =
            document.querySelectorAll(
                ".row-check:checked"
            ).length;

        selectedCount.textContent =
            toolbar.dataset.selectedCountFormat.replace("{0}", count);
    }

    selectAll.addEventListener(
        "change",
        function () {

            rowChecks.forEach(check => {
                check.checked = this.checked;
            });

            updateSelectedCount();
        });

    rowChecks.forEach(check => {

        check.addEventListener(
            "change",
            updateSelectedCount
        );

    });

    function editSelected() {

        const selected =
            Array.from(
                document.querySelectorAll(
                    ".row-check:checked"
                )
            );

        if (selected.length !== 1) {

            alert(
                toolbar.dataset.selectOneMessage
            );

            return;
        }

        window.location.href =
            "/Attributes/Edit/" +
            selected[0].value;
    }

    function confirmDelete() {

        const count =
            document.querySelectorAll(
                ".row-check:checked"
            ).length;

        if (count === 0) {

            alert(
                toolbar.dataset.selectMinMessage
            );

            return false;
        }

        return confirm(
            toolbar.dataset.confirmDeleteMessage
        );
    }

    updateSelectedCount();

</script>