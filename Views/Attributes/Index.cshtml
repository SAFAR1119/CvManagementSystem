@model IReadOnlyList<CvManagementSystem.Models.AttributeDefinition>

@{
    ViewData["Title"] = "Attribute Library";

    var categories =
        ViewBag.Categories
        as List<CvManagementSystem.Models.AttributeCategory>
        ?? new();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Attribute Library
            </h1>

            <p class="text-secondary mb-0">
                Reusable attributes for profiles, positions and CVs.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            New Attribute
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Error"]
        </div>
    }

    <form method="get"
          class="row g-2 mb-3">

        <div class="col-md-6">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by attribute name..." />
        </div>

        <div class="col-md-4">
            <select name="categoryId"
                    class="form-select">

                <option value="">
                    All categories
                </option>

                @foreach (var category in categories)
                {
                    if (ViewBag.CategoryId != null &&
                        ViewBag.CategoryId == category.Id)
                    {
                        <option value="@category.Id" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }
                }

            </select>
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-outline-primary w-100">
                Search
            </button>
        </div>

    </form>

    <!-- Toolbar -->
    <form asp-action="Delete"
          method="post"
          id="attributeForm">

        @Html.AntiForgeryToken()

        <div class="d-flex align-items-center gap-2 mb-2">

            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    onclick="editSelected()">
                Edit Selected
            </button>

            <button type="submit"
                    class="btn btn-outline-danger btn-sm"
                    onclick="return confirmDelete()">
                Delete Selected
            </button>

            <span id="selectedCount"
                  class="text-secondary small">
                0 selected
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th style="width: 45px;">
                            <input type="checkbox"
                                   id="selectAll"
                                   class="form-check-input" />
                        </th>

                        <th>Attribute</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Last Used</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center py-5 text-secondary">
                                No attributes found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <input type="checkbox"
                                           name="selectedIds"
                                           value="@item.Id"
                                           class="form-check-input row-check"
                                           data-id="@item.Id" />
                                </td>

                                <td>
                                    <strong>
                                        @item.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        item.Description))
                                    {
                                        <div class="small text-secondary">
                                            @item.Description
                                        </div>
                                    }
                                </td>

                                <td>
                                    @item.Category.Name
                                </td>

                                <td>
                                    <span class="badge text-bg-secondary">
                                        @item.DataType
                                    </span>
                                </td>

                                <td>
                                    @if (item.LastUsedAt.HasValue)
                                    {
                                        @item.LastUsedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            Never
                                        </span>
                                    }
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </form>

</div>

@section Scripts {
    <script>
        const selectAll =
            document.getElementById("selectAll");

        const rows =
            document.querySelectorAll(".row-check");

        const selectedCount =
            document.getElementById("selectedCount");

        function updateSelectedCount() {
            const selected =
                document.querySelectorAll(
                    ".row-check:checked"
                ).length;

            selectedCount.textContent =
                `${selected} selected`;

            selectAll.checked =
                rows.length > 0 &&
                selected === rows.length;
        }

        selectAll.addEventListener("change", function () {
            rows.forEach(row => {
                row.checked = selectAll.checked;
            });

            updateSelectedCount();
        });

        rows.forEach(row => {
            row.addEventListener(
                "change",
                updateSelectedCount
            );
        });

        function getSelected() {
            return Array.from(
                document.querySelectorAll(".row-check:checked")
            );
        }

        function editSelected() {
            const selected = getSelected();

            if (selected.length !== 1) {
                alert("Select exactly one attribute to edit.");
                return;
            }

            const id = selected[0].dataset.id;

            window.location.href =
                `/Attributes/Edit/${id}`;
        }

        function confirmDelete() {
            const selected = getSelected();

            if (selected.length === 0) {
                alert("Select at least one attribute.");
                return false;
            }

            return confirm(
                `Delete ${selected.length} selected attribute(s)?`
            );
        }

        updateSelectedCount();
    </script>
}