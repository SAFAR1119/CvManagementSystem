@model CvManagementSystem.ViewModels.AttributeDefinitionViewModel

@{
    ViewData["Title"] = L["CreateAttribute"].Value;
    var categories =
        ViewBag.Categories
        as List<CvManagementSystem.Models.AttributeCategory>
        ?? new();
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">@L["CreateAttribute"]</h1>

        <p class="text-secondary">
            @L["CreateAttributeDescription"]
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="@L["NamePlaceholderExample"]" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="@L["DescribeAttributePlaceholder"]">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId"
                               class="form-label">
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">

                            <option value="">
                                @L["SelectCategory"]
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DataType"
                               class="form-label">
                        </label>

                        <select asp-for="DataType"
                                asp-items="Html.GetEnumSelectList<CvManagementSystem.Models.AttributeDataType>()"
                                class="form-select"
                                id="dataType">
                        </select>

                        <span asp-validation-for="DataType"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="mb-3 d-none"
                     id="optionsContainer">

                    <label asp-for="OptionsText"
                           class="form-label">
                        @L["DropdownOptions"]
                    </label>

                    <textarea asp-for="OptionsText"
                              class="form-control"
                              rows="6"
                              placeholder="@L["OptionsExamplePlaceholder"]">
                    </textarea>

                    <div class="form-text">
                        @L["EnterOnePerLine"]
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-primary">
                        @L["CreateAttribute"]
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @L["Cancel"]
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateOptionsVisibility() {
            const type = document.getElementById("dataType");
            const container =
                document.getElementById("optionsContainer");

            // Dropdown is enum value 8.
            container.classList.toggle(
                "d-none",
                type.value !== "8"
            );
        }

        document
            .getElementById("dataType")
            .addEventListener(
                "change",
                updateOptionsVisibility
            );

        updateOptionsVisibility();
    </script>
}