@model CvManagementSystem.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Project Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                @Model.Name
            </h1>

            <p class="text-muted mb-0">
                @Model.Period
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Projects
        </a>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="h5">
                Description
            </h2>

            <div class="border rounded p-3">
                @Model.DescriptionMarkdown
            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Technology Tags</strong>
        </div>

        <div class="card-body">

            @{
                var tagNames = new Dictionary<int, string>
                {
                    { 1, "Java" },
                    { 2, ".NET" },
                    { 3, "C#" },
                    { 4, "JavaScript" },
                    { 5, "Next.js" },
                    { 6, "TypeScript" },
                    { 7, "Spring Boot" },
                    { 8, "NestJS" },
                    { 9, "PostgreSQL" },
                    { 10, "MySQL" },
                    { 11, "MongoDB" },
                    { 12, "Docker" },
                    { 13, "React" }
                };
            }

            <div class="d-flex flex-wrap gap-2">

                @foreach (var tagId in Model.SelectedTechnologyTagIds)
                {
                    if (tagNames.TryGetValue(tagId, out var tagName))
                    {
                        <span class="badge text-bg-light">
                            @tagName
                        </span>
                    }
                }

            </div>

        </div>

    </div>

</div>