@model CvManagementSystem.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = L["ProjectDetails"].Value;

    bool isAdministratorView =
        ViewBag.IsAdministratorView is bool value && value;
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

        <div>
            <h1 class="h3 mb-1">
                @(Model.Name)
            </h1>

            <p class="text-muted mb-0">
                @(Model.Period)
            </p>
        </div>

        <a asp-action="Index"
           asp-route-userId="@(isAdministratorView ? Model.UserId : null)"
           class="btn btn-outline-secondary">
            @L["BackToProjects"]
        </a>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>@L["ProjectInformation"]</strong>
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    @L["ProjectName"]
                </dt>

                <dd class="col-sm-9">
                    @(Model.Name)
                </dd>

                <dt class="col-sm-3">
                    @L["Period"]
                </dt>

                <dd class="col-sm-9">
                    @(Model.Period)
                </dd>

                <dt class="col-sm-3">
                    @L["StartDate"]
                </dt>

                <dd class="col-sm-9">
                    @(Model.StartDate.ToString("dd MMM yyyy"))
                </dd>

                <dt class="col-sm-3">
                    @L["EndDate"]
                </dt>

                <dd class="col-sm-9">

                    @if (Model.EndDate.HasValue)
                    {
                        @(Model.EndDate.Value.ToString("dd MMM yyyy"))
                    }
                    else
                    {
                        <span class="text-muted">
                            @L["Present"]
                        </span>
                    }

                </dd>

            </dl>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>@L["Description"]</strong>
        </div>

        <div class="card-body">

            <div class="border rounded p-3">
                @(Model.DescriptionMarkdown)
            </div>

            <div class="form-text mt-2">
                @L["DescriptionMarkdownNote"]
            </div>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>@L["TechnologyTags"]</strong>
        </div>

        <div class="card-body">

            @if (Model.TechnologyTags.Count == 0)
            {
                <span class="text-muted">
                    @L["NoTechnologyTagsAdded"]
                </span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.TechnologyTags)
                    {
                        <span class="badge text-bg-light p-2">
                            @(tag)
                        </span>
                    }

                </div>
            }

        </div>

    </div>

</div>