@model CvManagementSystem.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = L["EditProject"].Value;

    bool isAdministratorView =
        ViewBag.IsAdministratorView is bool value && value;
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="h3 mb-1">
            @L["EditProject"]
        </h1>

        <p class="text-muted mb-0">
            @L["UpdateProjectDescription"]
        </p>

    </div>

    <form asp-action="Edit"
          method="post"
          id="projectEditForm">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="UserId"
               type="hidden" />

        <input asp-for="CandidateProfileId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["ProjectInformation"]</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3 mb-3">

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="DescriptionMarkdown"
                           class="form-label">
                    </label>

                    <textarea asp-for="DescriptionMarkdown"
                              class="form-control"
                              rows="8"></textarea>

                    <span asp-validation-for="DescriptionMarkdown"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["TechnologyTags"]</strong>
            </div>

            <div class="card-body">

                <div id="tagContainer"
                     class="d-flex flex-wrap gap-2 mb-3">
                </div>

                <input type="text"
                       id="tagInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder="@L["TypeTechnologyPlaceholder"]" />

                <div id="tagSuggestions"
                     class="list-group mt-2">
                </div>

                <div id="tagHiddenInputs">
                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                @L["SaveChanges"]
            </button>

            <a asp-action="Index"
               asp-route-userId="@(isAdministratorView ? Model.UserId : null)"
               class="btn btn-outline-secondary">
                @L["Cancel"]
            </a>

        </div>

    </form>

</div>

<script>

    const tagInput =
        document.getElementById("tagInput");

    const tagContainer =
        document.getElementById("tagContainer");

    const tagSuggestions =
        document.getElementById("tagSuggestions");

    const tagHiddenInputs =
        document.getElementById("tagHiddenInputs");

    const tags = new Set();

    @foreach (var tag in Model.TechnologyTags)
    {
        <text>
        tags.add("@Html.Raw(
            System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(tag)
        )");
        </text>
    }

    function addTag(value)
    {
        const tag =
            value.trim();

        if (!tag)
        {
            return;
        }

        const exists =
            Array.from(tags)
                .some(
                    x =>
                        x.toLowerCase() ===
                        tag.toLowerCase());

        if (exists)
        {
            return;
        }

        tags.add(tag);

        renderTags();

        tagInput.value = "";

        tagSuggestions.innerHTML = "";
    }

    function removeTag(value)
    {
        tags.delete(value);

        renderTags();
    }

    function renderTags()
    {
        tagContainer.innerHTML = "";
        tagHiddenInputs.innerHTML = "";

        tags.forEach(
            tag =>
            {
                const badge =
                    document.createElement("span");

                badge.className =
                    "badge text-bg-primary d-inline-flex align-items-center gap-2 p-2";

                const label =
                    document.createElement("span");

                label.textContent = tag;

                badge.appendChild(label);

                const remove =
                    document.createElement("button");

                remove.type = "button";

                remove.className =
                    "btn-close btn-close-white";

                remove.style.fontSize =
                    "0.65rem";

                remove.addEventListener(
                    "click",
                    () => removeTag(tag));

                badge.appendChild(remove);

                tagContainer.appendChild(
                    badge);

                const hidden =
                    document.createElement("input");

                hidden.type = "hidden";

                hidden.name =
                    "TechnologyTags";

                hidden.value =
                    tag;

                tagHiddenInputs.appendChild(
                    hidden);
            });
    }

    tagInput.addEventListener(
        "keydown",
        function (event)
        {
            if (event.key === "Enter")
            {
                event.preventDefault();

                addTag(tagInput.value);
            }
        });

    let searchTimer;

    tagInput.addEventListener(
        "input",
        function ()
        {
            clearTimeout(searchTimer);

            const term =
                this.value.trim();

            if (!term)
            {
                tagSuggestions.innerHTML = "";
                return;
            }

            searchTimer =
                setTimeout(
                    async () =>
                    {
                        try
                        {
                            const response =
                                await fetch(
                                    "/Projects/SearchTags?term=" +
                                    encodeURIComponent(term));

                            if (!response.ok)
                            {
                                return;
                            }

                            const suggestions =
                                await response.json();

                            tagSuggestions.innerHTML = "";

                            suggestions.forEach(
                                tag =>
                                {
                                    const item =
                                        document.createElement(
                                            "button");

                                    item.type =
                                        "button";

                                    item.className =
                                        "list-group-item list-group-item-action";

                                    item.textContent =
                                        tag;

                                    item.addEventListener(
                                        "click",
                                        () =>
                                            addTag(tag));

                                    tagSuggestions.appendChild(
                                        item);
                                });
                        }
                        catch
                        {
                            tagSuggestions.innerHTML = "";
                        }
                    },
                    250);
        });

    renderTags();

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}