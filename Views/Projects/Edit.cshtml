@model CvManagementSystem.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="h3 mb-1">Edit Project</h1>

        <p class="text-muted mb-0">
            Update the project information and technology tags.
        </p>

    </div>

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3 mb-3">

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="DescriptionMarkdown"
                           class="form-label">
                    </label>

                    <textarea asp-for="DescriptionMarkdown"
                              class="form-control"
                              rows="7"></textarea>

                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Technology Tags</strong>
            </div>

            <div class="card-body">

                <div class="row g-2">

                    @foreach (var tag in Model.AvailableTechnologyTags)
                    {
                        var selected =
                            Model.SelectedTechnologyTagIds.Contains(tag.Id);

                        <div class="col-6 col-md-4 col-lg-3">

                            <label class="border rounded p-3 d-flex align-items-center gap-2 h-100">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="SelectedTechnologyTagIds"
                                       value="@tag.Id"
                                       @(selected ? "checked" : "") />

                                <span>
                                    @tag.Name
                                </span>

                            </label>

                        </div>
                    }

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}