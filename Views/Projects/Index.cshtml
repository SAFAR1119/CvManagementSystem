@model IReadOnlyList<CvManagementSystem.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "Projects";

    string? targetUserId =
        ViewBag.TargetUserId as string;

    bool isAdministratorView =
        ViewBag.IsAdministratorView is bool value && value;
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                @(isAdministratorView ? "Candidate Projects" : "My Projects")
            </h1>

            <p class="text-muted mb-0">
                Manage projects that can be selected for position-specific CVs.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-userId="@(isAdministratorView ? targetUserId : null)"
           class="btn btn-primary">
            Add Project
        </a>

    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">
            @error
        </div>
    }

    <form asp-action="Delete"
          method="post"
          id="projectForm">

        @Html.AntiForgeryToken()

        @if (isAdministratorView)
        {
            <input type="hidden"
                   name="userId"
                   value="@targetUserId" />
        }

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <button type="button"
                            id="editSelected"
                            class="btn btn-outline-primary">
                        Edit Selected
                    </button>

                    <button type="submit"
                            class="btn btn-outline-danger"
                            onclick="return confirmDelete()">
                        Delete Selected
                    </button>

                    <button type="button"
                            id="selectAllButton"
                            class="btn btn-outline-secondary">
                        Select All
                    </button>

                    <button type="button"
                            id="clearSelectionButton"
                            class="btn btn-outline-secondary">
                        Clear Selection
                    </button>

                    <span id="selectedCount"
                          class="text-muted small">
                        0 selected
                    </span>

                </div>

            </div>

        </div>

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th style="width: 45px;">

                                    <input type="checkbox"
                                           id="selectAll"
                                           class="form-check-input" />

                                </th>

                                <th>
                                    Project
                                </th>

                                <th>
                                    Period
                                </th>

                                <th>
                                    Technology Tags
                                </th>

                                <th>
                                    Description
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.Count == 0)
                            {
                                <tr>

                                    <td colspan="5"
                                        class="text-center text-muted py-5">

                                        No projects have been added yet.

                                    </td>

                                </tr>
                            }
                            else
                            {
                                foreach (var project in Model)
                                {
                                    <tr>

                                        <td>

                                            <input type="checkbox"
                                                   class="project-check form-check-input"
                                                   name="selectedIds"
                                                   value="@project.Id" />

                                        </td>

                                        <td>
                                            <strong>
                                                @(project.Name)
                                            </strong>
                                        </td>

                                        <td>
                                            @(project.Period)
                                        </td>

                                        <td>

                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var tag in project.TechnologyTags)
                                                {
                                                    <span class="badge text-bg-light">
                                                        @(tag)
                                                    </span>
                                                }

                                            </div>

                                        </td>

                                        <td>
                                            @(project.DescriptionMarkdown)
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </form>

</div>

<script>

    const selectAll =
        document.getElementById("selectAll");

    const checks =
        document.querySelectorAll(".project-check");

    const selectedCount =
        document.getElementById("selectedCount");

    function updateCount()
    {
        selectedCount.textContent =
            document.querySelectorAll(
                ".project-check:checked"
            ).length + " selected";
    }

    function setAll(value)
    {
        checks.forEach(
            check =>
            {
                check.checked = value;
            });

        selectAll.checked = value;

        updateCount();
    }

    selectAll.addEventListener(
        "change",
        function ()
        {
            setAll(this.checked);
        });

    checks.forEach(
        check =>
        {
            check.addEventListener(
                "change",
                function ()
                {
                    const all =
                        Array.from(checks)
                            .every(x => x.checked);

                    const none =
                        Array.from(checks)
                            .every(x => !x.checked);

                    selectAll.checked = all;

                    selectAll.indeterminate =
                        !all && !none;

                    updateCount();
                });
        });

    document
        .getElementById("selectAllButton")
        .addEventListener(
            "click",
            function ()
            {
                setAll(true);
            });

    document
        .getElementById("clearSelectionButton")
        .addEventListener(
            "click",
            function ()
            {
                setAll(false);
            });

    document
        .getElementById("editSelected")
        .addEventListener(
            "click",
            function ()
            {
                const selected =
                    Array.from(
                        document.querySelectorAll(
                            ".project-check:checked"
                        ));

                if (selected.length !== 1)
                {
                    alert(
                        "Select exactly one project to edit."
                    );

                    return;
                }

                const projectId =
                    selected[0].value;

                const userId =
                    "@(isAdministratorView ? targetUserId : "")";

                let url =
                    "/Projects/Edit/" +
                    projectId;

                if (userId)
                {
                    url +=
                        "?userId=" +
                        encodeURIComponent(userId);
                }

                window.location.href = url;
            });

    function confirmDelete()
    {
        const count =
            document.querySelectorAll(
                ".project-check:checked"
            ).length;

        if (count === 0)
        {
            alert(
                "Select at least one project."
            );

            return false;
        }

        return confirm(
            "Delete the selected project(s)?"
        );
    }

    updateCount();

</script>