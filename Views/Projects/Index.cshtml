@model IReadOnlyList<CvManagementSystem.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Projects</h1>

            <p class="text-muted mb-0">
                Manage the projects that can be included in your generated CVs.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Project
        </a>

    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-3">

                <input id="projectSearch"
                       type="text"
                       class="form-control"
                       placeholder="Search projects or technologies..." />

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="projectsTable">

                    <thead>

                        <tr>
                            <th>Project</th>
                            <th>Period</th>
                            <th>Technology Tags</th>
                            <th>Description</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var project in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @project.Name
                                    </strong>
                                </td>

                                <td>
                                    @project.Period
                                </td>

                                <td>

                                    <div class="d-flex flex-wrap gap-1">

                                        @foreach (var tagId in project.SelectedTechnologyTagIds)
                                        {
                                            var tagName = tagId switch
                                            {
                                                1 => "Java",
                                                2 => ".NET",
                                                3 => "C#",
                                                4 => "JavaScript",
                                                5 => "Next.js",
                                                6 => "TypeScript",
                                                7 => "Spring Boot",
                                                8 => "NestJS",
                                                9 => "PostgreSQL",
                                                10 => "MySQL",
                                                11 => "MongoDB",
                                                12 => "Docker",
                                                13 => "React",
                                                _ => "Unknown"
                                            };

                                            <span class="badge text-bg-light">
                                                @tagName
                                            </span>
                                        }

                                    </div>

                                </td>

                                <td>
                                    @project.DescriptionMarkdown
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="text-muted small mt-2">
                Select a project to edit or view its details once database
                persistence is enabled.
            </div>

        </div>

    </div>

</div>

<script>

    const searchInput =
        document.getElementById("projectSearch");

    const rows =
        document.querySelectorAll("#projectsTable tbody tr");

    searchInput.addEventListener("input", function () {

        const search =
            this.value.trim().toLowerCase();

        rows.forEach(row => {

            const text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(search) ? "" : "none";

        });

    });

</script>