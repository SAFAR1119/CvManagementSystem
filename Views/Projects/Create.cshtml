@model CvManagementSystem.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Add Project";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="h3 mb-1">Add Project</h1>

        <p class="text-muted mb-0">
            Add a project to your reusable candidate profile.
        </p>

    </div>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Project Information</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Example: E-commerce Website" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="row g-3 mb-3">

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Leave empty when the project is ongoing.
                        </div>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="DescriptionMarkdown"
                           class="form-label">
                    </label>

                    <textarea asp-for="DescriptionMarkdown"
                              class="form-control"
                              rows="7"
                              placeholder="Describe the project. Markdown can be used here."></textarea>

                    <span asp-validation-for="DescriptionMarkdown"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Technology Tags</strong>
            </div>

            <div class="card-body">

                <p class="text-muted">
                    Select the technologies used in this project.
                    These tags will later help the CV generator select
                    relevant projects for a position.
                </p>

                <div class="row g-2">

                    @foreach (var tag in Model.AvailableTechnologyTags)
                    {
                        <div class="col-6 col-md-4 col-lg-3">

                            <label class="border rounded p-3 d-flex align-items-center gap-2 h-100">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="SelectedTechnologyTagIds"
                                       value="@tag.Id" />

                                <span>
                                    @tag.Name
                                </span>

                            </label>

                        </div>
                    }

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Save Project
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}