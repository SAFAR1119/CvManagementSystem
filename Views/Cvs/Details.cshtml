@model CvManagementSystem.ViewModels.CvDetailsViewModel

@{
    ViewData["Title"] =
        $"{Model.PositionTitle} CV";
}

@if (User.IsInRole("Recruiter") ||
     User.IsInRole("Administrator"))
{
    <div class="d-flex align-items-center gap-3 mb-4">

        <form id="like-form"
              asp-controller="Cvs"
              asp-action="ToggleLike"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    id="like-button"
                    class="btn @(Model.IsLikedByCurrentUser
                        ? "btn-danger"
                        : "btn-outline-danger")">

                @(Model.IsLikedByCurrentUser
                    ? "Unlike"
                    : "Like")

            </button>

        </form>

        <span>
            <strong id="like-count">
                @Model.LikeCount
            </strong>
            like(s)
        </span>

    </div>
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

        <div>

            <h1 class="h3 mb-1">
                @(Model.PositionTitle) CV
            </h1>

            <p class="text-muted mb-0">
                Tailored CV generated from the candidate profile
                and the position template.
            </p>

        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Positions"
               asp-action="Details"
               asp-route-id="@Model.PositionId"
               class="btn btn-outline-secondary">
                View Position
            </a>

            @if (!Model.IsReadOnly &&
                 Model.CanPublish &&
                 !Model.IsPublished)
            {
                <form asp-action="Publish"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-success">
                        Publish CV
                    </button>

                </form>
            }

        </div>

    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @(success)
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">
            @(error)
        </div>
    }

    @if (Model.MissingRequiredAttributes > 0)
    {
        <div class="alert alert-warning">
            @(Model.MissingRequiredAttributes)
            required attribute(s) are still missing.
            They must be completed before the CV can be published.
        </div>
    }

            @if (Model.IsPublished)
    {
        <div class="alert alert-success">
            This CV is published. Changes you save below are immediately visible to recruiters.
        </div>
    }

    <article class="card shadow-sm mb-4 cv-resume">
        <div class="card-body p-md-5">
            <header class="text-center border-bottom pb-4 mb-4">
                <h1 class="display-6 mb-1">@Model.CandidateFirstName @Model.CandidateLastName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle)) { <div class="fs-5 text-muted">@Model.ProfessionalTitle</div> }
                <div class="small mt-2 text-muted">
                    @string.Join(" | ", new[] { Model.Location, Model.PhoneNumber, Model.Email }.Where(x => !string.IsNullOrWhiteSpace(x)))
                </div>
                <div class="small mt-1">
                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl)) { <a href="@Model.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a> }
                    @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl)) { <span class="mx-1">|</span><a href="@Model.GitHubUrl" target="_blank" rel="noopener">GitHub</a> }
                    @if (!string.IsNullOrWhiteSpace(Model.PortfolioUrl)) { <span class="mx-1">|</span><a href="@Model.PortfolioUrl" target="_blank" rel="noopener">Portfolio</a> }
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.ProfessionalSummary))
            {
                <section class="mb-4"><h2 class="h5 text-uppercase border-bottom pb-2">Professional Summary</h2><p class="mb-0" style="white-space: pre-line">@Model.ProfessionalSummary</p></section>
            }

            @if (Model.Attributes.Count > 0)
            {
                <section class="mb-4"><h2 class="h5 text-uppercase border-bottom pb-2">Core Skills & Relevant Information</h2><div class="d-flex flex-wrap gap-2">
                    @foreach (var resumeItem in Model.Attributes.Where(x => !string.IsNullOrWhiteSpace(x.Value))) { <span class="badge rounded-pill text-bg-light border p-2"><span class="text-muted">@resumeItem.Name:</span> @resumeItem.Value</span> }
                </div></section>
            }

            @if (Model.WorkExperiences.Count > 0)
            {
                <section class="mb-4"><h2 class="h5 text-uppercase border-bottom pb-2">Work Experience</h2>
                    @foreach (var experience in Model.WorkExperiences) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@experience.JobTitle</strong><div>@experience.CompanyName</div></div><small class="text-muted text-nowrap">@experience.StartDate.ToString("MMM yyyy") – @(experience.EndDate?.ToString("MMM yyyy") ?? "Present")</small></div>@if (!string.IsNullOrWhiteSpace(experience.Description)) { <p class="mb-1 mt-2" style="white-space:pre-line">@experience.Description</p> }@if (!string.IsNullOrWhiteSpace(experience.Technologies)) { <div class="small"><strong>Technologies:</strong> @experience.Technologies</div> }</article> }
                </section>
            }

            @if (Model.EducationEntries.Count > 0)
            {
                <section class="mb-4"><h2 class="h5 text-uppercase border-bottom pb-2">Education</h2>
                    @foreach (var education in Model.EducationEntries) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@education.Degree</strong><div>@education.Institution</div></div><small class="text-muted text-nowrap">@education.StartDate.ToString("MMM yyyy") – @(education.EndDate?.ToString("MMM yyyy") ?? "Present")</small></div>@if (!string.IsNullOrWhiteSpace(education.Description)) { <p class="mb-0 mt-2" style="white-space:pre-line">@education.Description</p> }</article> }
                </section>
            }

            <section><h2 class="h5 text-uppercase border-bottom pb-2">Selected Projects</h2>
                @if (Model.Projects.Count == 0) { <p class="text-muted mb-0">No projects matched this position's technology requirements.</p> }
                @foreach (var project in Model.Projects) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><strong>@project.Name</strong><small class="text-muted text-nowrap">@project.Period</small></div><p class="mb-1 mt-1" style="white-space:pre-line">@project.DescriptionMarkdown</p><div class="small text-muted">@string.Join(", ", project.TechnologyTags)</div></article> }
            </section>
        </div>
    </article>

    <form asp-action="Save"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="PositionId"
               type="hidden" />

        <input asp-for="ProfileVersion"
               type="hidden" />

        <!-- ================================================= -->
        <!-- CANDIDATE -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="CandidateFirstName"
                               class="form-label">
                            First Name
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.CandidateFirstName)
                            </div>
                        }
                        else
                        {
                            <input asp-for="CandidateFirstName"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ProfessionalTitle" class="form-label">Professional title</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.ProfessionalTitle ?? "Not provided")</div> }
                        else { <input asp-for="ProfessionalTitle" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PhoneNumber ?? "Not provided")</div> }
                        else { <input asp-for="PhoneNumber" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Email" class="form-label">Email</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.Email ?? "Not provided")</div> }
                        else { <input asp-for="Email" type="email" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="LinkedInUrl" class="form-label">LinkedIn URL</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.LinkedInUrl ?? "Not provided")</div> }
                        else { <input asp-for="LinkedInUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="GitHubUrl" class="form-label">GitHub URL</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.GitHubUrl ?? "Not provided")</div> }
                        else { <input asp-for="GitHubUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PortfolioUrl" class="form-label">Portfolio URL</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PortfolioUrl ?? "Not provided")</div> }
                        else { <input asp-for="PortfolioUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PhotoUrl" class="form-label">Photo URL</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PhotoUrl ?? "Not provided")</div> }
                        else { <input asp-for="PhotoUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-12">

                        <label asp-for="ProfessionalSummary" class="form-label">Professional summary</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light" style="white-space:pre-line">@(Model.ProfessionalSummary ?? "Not provided")</div> }
                        else { <textarea asp-for="ProfessionalSummary" class="form-control" rows="5"></textarea> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CandidateLastName"
                               class="form-label">
                            Last Name
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.CandidateLastName)
                            </div>
                        }
                        else
                        {
                            <input asp-for="CandidateLastName"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Location"
                               class="form-label">
                            Location
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.Location ?? "Not provided")
                            </div>
                        }
                        else
                        {
                            <input asp-for="Location"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <div class="small text-muted">
                            Status
                        </div>

                        @if (Model.IsPublished)
                        {
                            <span class="badge text-bg-success">
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                Draft
                            </span>
                        }

                        <div class="mt-3">

                            <span class="small text-muted">
                                Likes:
                            </span>

                            <strong>
                                @(Model.LikeCount)
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROFILE ATTRIBUTES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Relevant Information</strong>
            </div>

            <div class="card-body">

                @for (var i = 0;
                      i < Model.Attributes.Count;
                      i++)
                {
                    var attribute =
                        Model.Attributes[i];

                    var missing =
                        attribute.IsMissing;

                    <div class="mb-4 p-3 rounded border
                        @(missing && attribute.IsRequired
                            ? "border-danger bg-danger-subtle"
                            : "")">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <div>

                                <strong>
                                    @(attribute.Name)
                                </strong>

                                <div class="small text-muted">
                                    @(attribute.Category)
                                    ·
                                    @(attribute.DataType)
                                </div>

                            </div>

                            @if (attribute.IsRequired)
                            {
                                <span class="badge text-bg-danger">
                                    Required
                                </span>
                            }

                        </div>

                        <input type="hidden"
                               asp-for="Attributes[i].AttributeDefinitionId" />

                        <input type="hidden"
                               asp-for="Attributes[i].Version" />

                        <input type="hidden"
                               asp-for="Attributes[i].Name" />

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">

                                @if (attribute.IsMissing)
                                {
                                    <span class="text-danger">
                                        Information missing
                                    </span>
                                }
                                else
                                {
                                    @(attribute.Value)
                                }

                            </div>
                        }
                        else
                        {
                            @switch (attribute.DataType)
                            {
                                case CvManagementSystem.Models.AttributeDataType.Text:

                                    <textarea asp-for="Attributes[i].Value"
                                              class="form-control"
                                              rows="5"></textarea>

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Boolean:

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Attributes[@i].Value"
                                               value="false" />

                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="Attributes[@i].Value"
                                               value="true"
                                               id="cv_boolean_@i"
                                               @(string.Equals(
                                                   attribute.Value,
                                                   "true",
                                                   StringComparison.OrdinalIgnoreCase)
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label"
                                               for="cv_boolean_@i">
                                            Checked
                                        </label>

                                    </div>

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Date:

                                    <input asp-for="Attributes[i].Value"
                                           type="date"
                                           class="form-control" />

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Numeric:

                                    <input asp-for="Attributes[i].Value"
                                           type="number"
                                           step="any"
                                           class="form-control" />

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Dropdown:

                                    <select asp-for="Attributes[i].Value"
                                            class="form-select">

                                        <option value="">
                                            Select...
                                        </option>

                                        @foreach (var option
                                                 in attribute.Options)
                                        {
                                            if (attribute.Value == option)
                                            {
                                                <option value="@option"
                                                        selected>
                                                    @(option)
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@option">
                                                    @(option)
                                                </option>
                                            }
                                        }

                                    </select>

                                    break;

                                default:

                                    <input asp-for="Attributes[i].Value"
                                           class="form-control" />

                                    break;
                            }

                            @if (missing &&
                                 attribute.IsRequired)
                            {
                                <div class="text-danger small mt-1">
                                    This required field must be completed.
                                </div>
                            }
                        }

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROJECTS -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

        <div class="card-header">
                <strong>Projects from Profile</strong>
            </div>

            <div class="card-body">

                @if (Model.Projects.Count == 0)
                {
                    <div class="text-muted">
                        No projects have been added to this profile yet.
                    </div>
                }
                else
                {
                    @foreach (var project in Model.Projects)
                    {
                        <article class="border rounded p-3 mb-3">

                            <div class="d-flex flex-wrap justify-content-between gap-2">

                                <h2 class="h6 mb-1">
                                    @(project.Name)
                                </h2>

                                <span class="text-muted small">
                                    @(project.Period)
                                </span>

                            </div>

                            <p class="mb-2">
                                @(project.DescriptionMarkdown)
                            </p>

                            <div class="d-flex flex-wrap gap-1">

                                @foreach (var tag
                                         in project.TechnologyTags)
                                {
                                    <span class="badge text-bg-light">
                                        @(tag)
                                    </span>
                                }

                            </div>

                        </article>
                    }
                }

                @if (!Model.IsReadOnly)
                {
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        Manage projects in profile
                    </a>
                }

            </div>

        </div>

        @if (!Model.IsReadOnly)
        {
            <div class="d-flex justify-content-end mb-5">

                <button type="submit"
                        class="btn btn-primary">
                    Save CV
                </button>

            </div>
        }

    </form>

</div>

<script>
    (() => {
        const form =
            document.getElementById("like-form");

        if (!form) {
            return;
        }

        const button =
            document.getElementById("like-button");

        const count =
            document.getElementById("like-count");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const formData =
                new FormData(form);

            try {
                const response =
                    await fetch(
                        form.action,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                if (!response.ok) {
                    return;
                }

                const result =
                    await response.json();

                count.textContent =
                    result.likeCount;

                if (result.liked)
                {
                    button.textContent =
                        "Unlike";

                    button.classList.remove(
                        "btn-outline-danger");

                    button.classList.add(
                        "btn-danger");
                }
                else
                {
                    button.textContent =
                        "Like";

                    button.classList.remove(
                        "btn-danger");

                    button.classList.add(
                        "btn-outline-danger");
                }

            }
            catch (error)
            {
                console.error(
                    "Like request failed.",
                    error
                );
            }
        });
    })();
</script>
