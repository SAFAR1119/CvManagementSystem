@model CvManagementSystem.ViewModels.CvDetailsViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] =
        $"{Model.PositionTitle} {L["CV"]}";
}

@if (User.IsInRole("Recruiter") ||
     User.IsInRole("Administrator"))
{
    <div class="container pt-4">
    <div class="d-flex align-items-center gap-3 mb-0 cv-feedback">

        <form id="like-form"
              asp-controller="Cvs"
              asp-action="ToggleLike"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    id="like-button"
                    class="btn @(Model.IsLikedByCurrentUser
                        ? "btn-danger"
                        : "btn-outline-danger")">

                @(Model.IsLikedByCurrentUser
                    ? L["Unlike"]
                    : L["Like"])

            </button>

        </form>

        <span data-like-text="@L["Like"]" data-unlike-text="@L["Unlike"]">
            <strong id="like-count">
                @Model.LikeCount
            </strong>
            @L["LikesSuffix"]
        </span>

    </div>
    </div>
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

        <div>

            <h1 class="h3 mb-1">
                @(Model.PositionTitle) @L["CV"]
            </h1>

            <p class="text-muted mb-0">
                @L["TailoredCvDescription"]
            </p>

        </div>

        <div class="d-flex flex-wrap gap-2">

            <button type="button" class="btn btn-outline-primary" data-print-cv>
                @L["PrintCv"]
            </button>

            <a asp-controller="Positions"
               asp-action="Details"
               asp-route-id="@Model.PositionId"
               class="btn btn-outline-secondary">
                @L["ViewPosition"]
            </a>

            @if (!Model.IsReadOnly &&
                 Model.CanPublish &&
                 !Model.IsPublished)
            {
                <form asp-action="Publish"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-success">
                        @L["PublishCv"]
                    </button>

                </form>
            }

        </div>

    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @(success)
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">
            @(error)
        </div>
    }

    @if (Model.MissingRequiredAttributes > 0)
    {
        <div class="alert alert-warning">
            @string.Format(L["MissingRequiredAttributesFull"].Value, Model.MissingRequiredAttributes)
        </div>
    }

            @if (Model.IsPublished)
    {
        <div class="alert alert-success">
            @L["CvPublishedNotice"]
        </div>
    }

    <article class="cv-resume mb-5" aria-label="Candidate CV">
        <div class="cv-sheet blueprint">
            <span class="corner tl"></span>
            <span class="corner tr"></span>
            <span class="corner bl"></span>
            <span class="corner br"></span>
            <header class="cv-header">
                <div class="cv-eyebrow">@L["ProfessionalResume"]</div>
                <h1>@Model.CandidateFirstName @Model.CandidateLastName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle)) { <div class="cv-role">@Model.ProfessionalTitle</div> }
                <div class="cv-contact">
                    @string.Join(" | ", new[] { Model.Location, Model.PhoneNumber, Model.Email }.Where(x => !string.IsNullOrWhiteSpace(x)))
                </div>
                <div class="cv-links">
                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl)) { <a href="@Model.LinkedInUrl" target="_blank" rel="noopener">@L["LinkedIn"]</a> }
                    @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl)) { <span class="mx-1">|</span><a href="@Model.GitHubUrl" target="_blank" rel="noopener">@L["GitHub"]</a> }
                    @if (!string.IsNullOrWhiteSpace(Model.PortfolioUrl)) { <span class="mx-1">|</span><a href="@Model.PortfolioUrl" target="_blank" rel="noopener">@L["Portfolio"]</a> }
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.ProfessionalSummary))
            {
                <section class="cv-section"><h2>@L["ProfessionalSummary"]</h2><p class="mb-0" style="white-space: pre-line">@Model.ProfessionalSummary</p></section>
            }

            @if (Model.Attributes.Count > 0)
            {
                <section class="cv-section"><h2>@L["CoreSkills"]</h2><div class="d-flex flex-wrap gap-2">
                    @foreach (var resumeItem in Model.Attributes.Where(x => !string.IsNullOrWhiteSpace(x.Value))) { <span class="cv-skill"><span>@resumeItem.Name:</span> @resumeItem.Value</span> }
                </div></section>
            }

            @if (Model.WorkExperiences.Count > 0)
            {
                <section class="cv-section"><h2>@L["WorkExperience"]</h2>
                    @foreach (var experience in Model.WorkExperiences) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@experience.JobTitle</strong><div>@experience.CompanyName</div></div><small class="text-muted text-nowrap">@experience.StartDate.ToString("MMM yyyy") – @(experience.EndDate?.ToString("MMM yyyy") ?? L["Present"].Value)</small></div>@if (!string.IsNullOrWhiteSpace(experience.Description)) { <p class="mb-1 mt-2" style="white-space:pre-line">@experience.Description</p> }@if (!string.IsNullOrWhiteSpace(experience.Technologies)) { <div class="small"><strong>@L["TechnologiesLabel"]</strong> @experience.Technologies</div> }</article> }
                </section>
            }

            @if (Model.EducationEntries.Count > 0)
            {
                <section class="cv-section"><h2>@L["Education"]</h2>
                    @foreach (var education in Model.EducationEntries) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@education.Degree</strong><div>@education.Institution</div></div><small class="text-muted text-nowrap">@education.StartDate.ToString("MMM yyyy") – @(education.EndDate?.ToString("MMM yyyy") ?? L["Present"].Value)</small></div>@if (!string.IsNullOrWhiteSpace(education.Description)) { <p class="mb-0 mt-2" style="white-space:pre-line">@education.Description</p> }</article> }
                </section>
            }

            <section class="cv-section mb-0"><h2>@L["SelectedProjects"]</h2>
                @if (Model.Projects.Count == 0) { <p class="text-muted mb-0">@L["NoProjectsMatched"]</p> }
                @foreach (var project in Model.Projects) { <article class="mb-3"><div class="d-flex justify-content-between gap-3"><strong>@project.Name</strong><small class="text-muted text-nowrap">@project.Period</small></div><p class="mb-1 mt-1" style="white-space:pre-line">@project.DescriptionMarkdown</p><div class="small text-muted">@string.Join(", ", project.TechnologyTags)</div></article> }
            </section>
        </div>
    </article>

    @if (!Model.IsReadOnly)
    {
    <section class="cv-editor">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div><div class="section-kicker">@L["Manage"]</div><h2 class="h4 mb-0">@L["EditCvDetails"]</h2></div>
            <span class="text-muted small">@L["ChangesUpdatePreview"]</span>
        </div>
    <form asp-action="Save"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="PositionId"
               type="hidden" />

        <input asp-for="ProfileVersion"
               type="hidden" />

        <!-- ================================================= -->
        <!-- CANDIDATE -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="CandidateFirstName"
                               class="form-label">
                            @L["FirstName"]
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.CandidateFirstName)
                            </div>
                        }
                        else
                        {
                            <input asp-for="CandidateFirstName"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ProfessionalTitle" class="form-label">@L["ProfessionalTitleLabel"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.ProfessionalTitle ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="ProfessionalTitle" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PhoneNumber" class="form-label">@L["PhoneNumber"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PhoneNumber ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="PhoneNumber" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Email" class="form-label">@L["Email"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.Email ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="Email" type="email" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="LinkedInUrl" class="form-label">@L["LinkedInUrl"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.LinkedInUrl ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="LinkedInUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="GitHubUrl" class="form-label">@L["GitHubUrl"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.GitHubUrl ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="GitHubUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PortfolioUrl" class="form-label">@L["PortfolioUrl"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PortfolioUrl ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="PortfolioUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="PhotoUrl" class="form-label">@L["PhotoUrl"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light">@(Model.PhotoUrl ?? L["NotProvided"].Value)</div> }
                        else { <input asp-for="PhotoUrl" type="url" class="form-control" /> }

                    </div>

                    <div class="col-12">

                        <label asp-for="ProfessionalSummary" class="form-label">@L["ProfessionalSummary"]</label>
                        @if (Model.IsReadOnly) { <div class="form-control bg-light" style="white-space:pre-line">@(Model.ProfessionalSummary ?? L["NotProvided"].Value)</div> }
                        else { <textarea asp-for="ProfessionalSummary" class="form-control" rows="5"></textarea> }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CandidateLastName"
                               class="form-label">
                            @L["LastName"]
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.CandidateLastName)
                            </div>
                        }
                        else
                        {
                            <input asp-for="CandidateLastName"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Location"
                               class="form-label">
                            @L["Location"]
                        </label>

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light">
                                @(Model.Location ?? L["NotProvided"].Value)
                            </div>
                        }
                        else
                        {
                            <input asp-for="Location"
                                   class="form-control" />
                        }

                    </div>

                    <div class="col-md-6">

                        <div class="small text-muted">
                            @L["Status"]
                        </div>

                        @if (Model.IsPublished)
                        {
                            <span class="badge text-bg-success">
                                @L["Published"]
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                @L["Draft"]
                            </span>
                        }

                        <div class="mt-3">

                            <span class="small text-muted">
                                @L["LikesLabel"]
                            </span>

                            <strong>
                                @(Model.LikeCount)
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROFILE ATTRIBUTES -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>@L["RelevantInformation"]</strong>
            </div>

            <div class="card-body">

                @for (var i = 0;
                      i < Model.Attributes.Count;
                      i++)
                {
                    var attribute =
                        Model.Attributes[i];

                    var missing =
                        attribute.IsMissing;

                    <div class="mb-4 p-3 rounded border
                        @(missing && attribute.IsRequired
                            ? "border-danger bg-danger-subtle"
                            : "")">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <div>

                                <strong>
                                    @(attribute.Name)
                                </strong>

                                <div class="small text-muted">
                                    @(attribute.Category)
                                    ·
                                    @(attribute.DataType)
                                </div>

                            </div>

                            @if (attribute.IsRequired)
                            {
                                <span class="badge text-bg-danger">
                                    @L["Required"]
                                </span>
                            }

                        </div>

                        <input type="hidden"
                               asp-for="Attributes[i].AttributeDefinitionId" />

                        <input type="hidden"
                               asp-for="Attributes[i].Version" />

                        <input type="hidden"
                               asp-for="Attributes[i].Name" />

                        @if (Model.IsReadOnly)
                        {
                            <div class="form-control bg-light h-auto">

                                @if (attribute.IsMissing)
                                {
                                    <span class="text-danger">
                                        @L["InformationMissing"]
                                    </span>
                                }
                                else if (attribute.DataType == CvManagementSystem.Models.AttributeDataType.Text)
                                {
                                    <div class="attribute-markdown">
                                        @Html.Raw(attribute.ValueHtml)
                                    </div>
                                }
                                else if (attribute.DataType == CvManagementSystem.Models.AttributeDataType.Boolean)
                                {
                                    @(string.Equals(attribute.Value, "true", StringComparison.OrdinalIgnoreCase) ? L["Yes"] : L["No"])
                                }
                                else if (attribute.DataType == CvManagementSystem.Models.AttributeDataType.Image)
                                {
                                    <img src="@(attribute.Value)"
                                         alt="@(attribute.Name)"
                                         class="img-fluid rounded"
                                         style="max-height: 160px;" />
                                }
                                else
                                {
                                    @(attribute.Value)
                                }

                            </div>
                        }
                        else
                        {
                            @switch (attribute.DataType)
                            {
                                case CvManagementSystem.Models.AttributeDataType.Text:

                                    <textarea asp-for="Attributes[i].Value"
                                              class="form-control"
                                              rows="5"></textarea>

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Boolean:

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Attributes[@i].Value"
                                               value="false" />

                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="Attributes[@i].Value"
                                               value="true"
                                               id="cv_boolean_@i"
                                               @(string.Equals(
                                                   attribute.Value,
                                                   "true",
                                                   StringComparison.OrdinalIgnoreCase)
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label"
                                               for="cv_boolean_@i">
                                            @L["Checked"]
                                        </label>

                                    </div>

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Date:

                                    <input asp-for="Attributes[i].Value"
                                           type="date"
                                           class="form-control" />

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Numeric:

                                    <input asp-for="Attributes[i].Value"
                                           type="number"
                                           step="any"
                                           class="form-control" />

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Dropdown:

                                    <select asp-for="Attributes[i].Value"
                                            class="form-select">

                                        <option value="">
                                            @L["SelectEllipsis"]
                                        </option>

                                        @foreach (var option
                                                 in attribute.Options)
                                        {
                                            if (attribute.Value == option)
                                            {
                                                <option value="@option"
                                                        selected>
                                                    @(option)
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@option">
                                                    @(option)
                                                </option>
                                            }
                                        }

                                    </select>

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Period:

                                    <input asp-for="Attributes[i].Value"
                                           type="text"
                                           class="form-control"
                                           placeholder="YYYY-MM-DD - YYYY-MM-DD" />

                                    break;

                                case CvManagementSystem.Models.AttributeDataType.Image:

                                    <input asp-for="Attributes[i].Value"
                                           type="url"
                                           id="cv-attribute-image-@i"
                                           class="form-control"
                                           placeholder="https://..." />

                                    <div class="cloud-image-dropzone border rounded p-3 mt-2 text-center"
                                         data-input-id="cv-attribute-image-@i"
                                         data-cloud-name="@Configuration["Cloudinary:CloudName"]"
                                         data-upload-preset="@Configuration["Cloudinary:UploadPreset"]"
                                         data-msg-choose-file="@L["ChooseImageFile"]"
                                         data-msg-size-limit="@L["ImageSizeLimit"]"
                                         data-msg-not-configured="@L["CloudUploadNotConfigured"]"
                                         data-msg-uploading="@L["UploadingImage"]"
                                         data-msg-upload-failed="@L["UploadFailed"]"
                                         data-msg-uploaded="@L["ImageUploadedReady"]"
                                         tabindex="0">
                                        <input type="file" accept="image/*" class="d-none cloud-image-file" />
                                        <div class="small text-muted">@L["DragImageHere"] <button type="button" class="btn btn-link btn-sm p-0 cloud-image-browse">@L["ChooseFile"]</button>. @L["ImagesUploadedDirectly"]</div>
                                        <div class="small mt-1 cloud-image-status"></div>
                                    </div>

                                    break;

                                default:

                                    <input asp-for="Attributes[i].Value"
                                           class="form-control" />

                                    break;
                            }

                            @if (missing &&
                                 attribute.IsRequired)
                            {
                                <div class="text-danger small mt-1">
                                    @L["FieldRequiredMessage"]
                                </div>
                            }
                        }

                    </div>
                }

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROJECTS -->
        <!-- ================================================= -->

        <div class="card shadow-sm mb-4">

        <div class="card-header">
                <strong>@L["ProjectsFromProfile"]</strong>
            </div>

            <div class="card-body">

                @if (Model.Projects.Count == 0)
                {
                    <div class="text-muted">
                        @L["NoProjectsAddedToProfile"]
                    </div>
                }
                else
                {
                    @foreach (var project in Model.Projects)
                    {
                        <article class="border rounded p-3 mb-3">

                            <div class="d-flex flex-wrap justify-content-between gap-2">

                                <h2 class="h6 mb-1">
                                    @(project.Name)
                                </h2>

                                <span class="text-muted small">
                                    @(project.Period)
                                </span>

                            </div>

                            <p class="mb-2">
                                @(project.DescriptionMarkdown)
                            </p>

                            <div class="d-flex flex-wrap gap-1">

                                @foreach (var tag
                                         in project.TechnologyTags)
                                {
                                    <span class="badge text-bg-light">
                                        @(tag)
                                    </span>
                                }

                            </div>

                        </article>
                    }
                }

                @if (!Model.IsReadOnly)
                {
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        @L["ManageProjectsInProfile"]
                    </a>
                }

            </div>

        </div>

        @if (!Model.IsReadOnly)
        {
            <div class="d-flex justify-content-end mb-5">

                <button type="submit"
                        class="btn btn-primary">
                    @L["SaveCv"]
                </button>

            </div>
        }

    </form>
    </section>
    }

</div>

@section Scripts {
<script>
    document.querySelector('[data-print-cv]')?.addEventListener('click', () => window.print());
</script>
}

<script>
    (() => {
        const form =
            document.getElementById("like-form");

        if (!form) {
            return;
        }

        const button =
            document.getElementById("like-button");

        const count =
            document.getElementById("like-count");

        const likeText = count.closest("[data-like-text]");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const formData =
                new FormData(form);

            try {
                const response =
                    await fetch(
                        form.action,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                if (!response.ok) {
                    return;
                }

                const result =
                    await response.json();

                count.textContent =
                    result.likeCount;

                if (result.liked)
                {
                    button.textContent =
                        likeText.dataset.unlikeText;

                    button.classList.remove(
                        "btn-outline-danger");

                    button.classList.add(
                        "btn-danger");
                }
                else
                {
                    button.textContent =
                        likeText.dataset.likeText;

                    button.classList.remove(
                        "btn-danger");

                    button.classList.add(
                        "btn-outline-danger");
                }

            }
            catch (error)
            {
                console.error(
                    "Like request failed.",
                    error
                );
            }
        });
    })();
</script>

<script>
    // Image attributes are stored as URLs. When Cloudinary's unsigned
    // upload values are configured, files go directly from the browser to
    // Cloudinary; this application never receives or stores the image.
    document.querySelectorAll(".cloud-image-dropzone").forEach(dropzone => {
        const input = document.getElementById(dropzone.dataset.inputId);
        const fileInput = dropzone.querySelector(".cloud-image-file");
        const browse = dropzone.querySelector(".cloud-image-browse");
        const status = dropzone.querySelector(".cloud-image-status");
        const cloudName = dropzone.dataset.cloudName;
        const uploadPreset = dropzone.dataset.uploadPreset;

        const setStatus = (message, isError = false) => {
            status.textContent = message;
            status.className = "small mt-1 cloud-image-status " +
                (isError ? "text-danger" : "text-muted");
        };

        const upload = async file => {
            if (!file || !file.type.startsWith("image/")) {
                setStatus(dropzone.dataset.msgChooseFile, true);
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                setStatus(dropzone.dataset.msgSizeLimit, true);
                return;
            }
            if (!cloudName || !uploadPreset) {
                setStatus(dropzone.dataset.msgNotConfigured, true);
                return;
            }

            const formData = new FormData();
            formData.append("file", file);
            formData.append("upload_preset", uploadPreset);
            setStatus(dropzone.dataset.msgUploading);

            try {
                const response = await fetch(
                    `https://api.cloudinary.com/v1_1/${encodeURIComponent(cloudName)}/image/upload`,
                    { method: "POST", body: formData });
                const result = await response.json();
                if (!response.ok || !result.secure_url) {
                    throw new Error(result.error?.message || dropzone.dataset.msgUploadFailed);
                }
                input.value = result.secure_url;
                input.dispatchEvent(new Event("input", { bubbles: true }));
                input.dispatchEvent(new Event("change", { bubbles: true }));
                setStatus(dropzone.dataset.msgUploaded);
            } catch (error) {
                setStatus(error.message || dropzone.dataset.msgUploadFailed, true);
            }
        };

        browse.addEventListener("click", () => fileInput.click());
        fileInput.addEventListener("change", () => upload(fileInput.files[0]));
        dropzone.addEventListener("dragover", event => {
            event.preventDefault();
            dropzone.classList.add("border-primary", "bg-body-tertiary");
        });
        dropzone.addEventListener("dragleave", () =>
            dropzone.classList.remove("border-primary", "bg-body-tertiary"));
        dropzone.addEventListener("drop", event => {
            event.preventDefault();
            dropzone.classList.remove("border-primary", "bg-body-tertiary");
            upload(event.dataTransfer.files[0]);
        });
        dropzone.addEventListener("keydown", event => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                fileInput.click();
            }
        });
    });
</script>
