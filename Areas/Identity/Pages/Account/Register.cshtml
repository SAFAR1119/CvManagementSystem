@page
@model CvManagementSystem.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = L["CreateAccount"].Value;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="text-center mb-4">
                <span class="badge text-bg-primary mb-3">
                    @L["CvMaster"]
                </span>

                <h1 class="fw-bold">
                    @L["CreateYourAccount"]
                </h1>

                <p class="text-secondary">
                    @L["RegisterDescription"]

                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                   class="form-label">@L["Email"]</label>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="@L["EmailPlaceholder"]" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label">@L["Password"]</label>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="@L["CreatePassword"]" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">@L["ConfirmPassword"]</label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="@L["ConfirmPassword"]" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            @L["CreateAccount"]
                        </button>

                        <div class="mb-3">
                          <label asp-for="SelectedRole"
                              class="form-label">
                               @L["AccountType"]
                          </label>

                          <select asp-for="SelectedRole"
                               class="form-select">
                             <option value="Candidate">
                                 @L["Candidate"]
                              </option>

                             <option value="Recruiter">
                                  @L["Recruiter"]
                             </option>
                           </select>

                           <div class="form-text">
                              @L["RegisterRoleHelp"]

                            </div>

                            <span asp-validation-for="SelectedRole"
                                 class="text-danger">
                            </span>
                      </div>

                    </form>

                    <div class="text-center mt-4">
                        <span class="text-secondary">
                            @L["AlreadyHaveAccount"]
                        </span>

                        <a asp-page="./Login"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            @L["SignIn"]
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
